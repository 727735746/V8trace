+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_V8TRACE_STATE_VALUES_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_BINDINGS_V8TRACE_STATE_VALUES_H_
+#include <array>
+#include "base/trace_event/v8trace-state-record.h"
+#include "third_party/blink/renderer/platform/wtf/text/wtf_string.h"
+#include "v8/include/v8-trace-identity.h"
+
+namespace blink::v8trace_state {
+inline base::DictValue Text(const char* channel, const std::string& operation, const char* field, const String& text) {
+  std::array<uint8_t, 32768> data;
+  if (text.length() <= 256) {
+    size_t used = 0; for (wtf_size_t i = 0; i < text.length(); ++i) { uint16_t unit = text[i]; data[used++] = uint8_t(unit); data[used++] = uint8_t(unit >> 8); }
+    base::DictValue value; value.Set("type", "inline-bytes"); value.Set("representation", "utf16le"); value.Set("null", text.IsNull()); value.Set("utf16Length", base::NumberToString(text.length())); value.Set("bytes", base::NumberToString(used)); value.Set("base64", base::Base64Encode(base::span(data).first(used))); return value;
+  }
+  std::string id = operation + '/' + field + '/' + base::NumberToString(base::trace_event::GetNextGlobalTraceId()); uint64_t offset = 0;
+  for (wtf_size_t index = 0; index < text.length();) {
+    size_t used = 0;
+    while (index < text.length() && used + 2 <= data.size()) { uint16_t unit = text[index++]; data[used++] = uint8_t(unit); data[used++] = uint8_t(unit >> 8); }
+    base::DictValue chunk; chunk.Set("kind", "value-chunk"); chunk.Set("contentId", id); chunk.Set("operationId", operation); chunk.Set("offset", base::NumberToString(offset)); chunk.Set("base64", base::Base64Encode(base::span(data).first(used))); ::v8trace_state::Emit(channel, std::move(chunk)); offset += used;
+  }
+  base::DictValue value; value.Set("type", "byte-reference"); value.Set("representation", "utf16le"); value.Set("null", text.IsNull()); value.Set("utf16Length", base::NumberToString(text.length())); value.Set("bytes", base::NumberToString(uint64_t(text.length()) * 2)); value.Set("contentId", id); return value;
+}
+inline void Exception(int code, const String& message, v8::Isolate* isolate) {
+  const auto& operations = ::v8trace_state::Operations(); if (operations.empty() || !isolate) return;
+  auto operation = operations.back(); base::DictValue record; record.Set("kind", "api-exception"); record.Set("operationId", operation.id); record.Set("code", code); record.Set("message", Text(operation.channel.c_str(), operation.id, "exception", message)); ::v8trace_state::Emit(operation.channel.c_str(), std::move(record));
+}
+inline void Rethrow(v8::Isolate* isolate, v8::Local<v8::Value> exception) {
+  const auto& operations = ::v8trace_state::Operations(); if (operations.empty() || !isolate) return;
+  auto operation = operations.back(); base::DictValue record; record.Set("kind", "api-rethrow"); record.Set("operationId", operation.id); record.Set("v8ValueJSON", v8::V8TraceValueJSON(isolate, exception)); ::v8trace_state::Emit(operation.channel.c_str(), std::move(record));
+}
+}
