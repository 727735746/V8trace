+inline bool Enabled() { return v8trace_browser::Enabled(kCategory); }
+struct State { std::string id; uint64_t bytes = 0; bool pipe = false; };
+inline std::unordered_map<std::string, State>& States() {
+  static thread_local std::unordered_map<std::string, State> states;
+  return states;
+}
+inline std::string Key(uint64_t identifier, const char* layer) {
+  return std::string(layer) + ":" + base::NumberToString(identifier);
+}
+inline State& Current(uint64_t identifier, const char* layer) {
+  return States()[Key(identifier, layer)];
+}
+inline base::DictValue Headers(const HTTPHeaderMap& headers) {
+  base::DictValue output;
+  for (const auto& header : headers) output.Set(header.key.Utf8(), header.value.Utf8());
+  return output;
+}
+inline void Begin(uint64_t identifier, const char* layer, const KURL& url,
+                  const String& method, const HTTPHeaderMap& headers,
+                  const EncodedFormData* body, bool stream = false) {
+  if (!Enabled() || !url.ProtocolIsInHttpFamily()) return;
+  static thread_local uint64_t requests = 0;
+  auto& state = Current(identifier, layer);
+  state = {Key(identifier, layer) + ":" + base::NumberToString(++requests), 0, false};
+  base::DictValue record;
+  record.Set("kind", "request"); record.Set("requestId", state.id);
+  record.Set("layer", layer); record.Set("url", url.GetString().Utf8());
+  record.Set("resourceIdentifier", base::NumberToString(identifier));
+  record.Set("method", method.Utf8()); record.Set("headers", Headers(headers));
+  record.Set("requestBodyPresent", body || stream);
+  record.Set("requestBodyComplete", !stream);
+  v8trace_browser::Http(std::move(record));
+  uint64_t offset = 0;
+  bool complete = !stream;
+  if (body) for (const auto& element : body->Elements()) {
+    if (element.type_ == FormDataElement::kData) {
+      auto bytes = base::as_bytes(base::span(element.data_));
+      v8trace_browser::Chunk(state.id, "request", offset, bytes, layer);
+      offset += bytes.size();
+    } else {
+      complete = false;
+      base::DictValue gap;
+      gap.Set("kind", "upload-external-element"); gap.Set("requestId", state.id);
+      gap.Set("elementType", static_cast<int>(element.type_));
+      gap.Set("filename", element.filename_.Utf8());
+      gap.Set("offset", base::NumberToString(offset));
+      v8trace_browser::Http(std::move(gap));
+    }
+  }
+  base::DictValue end;
+  end.Set("kind", "request-body-end"); end.Set("requestId", state.id);
+  end.Set("complete", complete); end.Set("bytes", base::NumberToString(offset));
+  v8trace_browser::Http(std::move(end));
+}
+inline void Begin(uint64_t id, const char* layer, const ResourceRequestHead& req,
+                  const ResourceRequestBody* body = nullptr) {
+  Begin(id, layer, req.Url(), req.HttpMethod(), req.HttpHeaderFields(),
+        body ? body->FormBody().get() : nullptr, body && body->StreamBody().is_valid());
+}
+inline void Response(uint64_t id, const char* layer, const ResourceResponse& response) {
+  if (!Enabled()) return;
+  const auto& state = Current(id, layer); if (state.id.empty()) return;
+  base::DictValue record;
+  record.Set("kind", "response"); record.Set("requestId", state.id);
+  record.Set("url", response.CurrentRequestUrl().GetString().Utf8());
+  record.Set("status", response.HttpStatusCode());
+  record.Set("statusText", response.HttpStatusText().Utf8());
+  record.Set("mimeType", response.MimeType().Utf8());
+  record.Set("headers", Headers(response.HttpHeaderFields()));
+  record.Set("fromServiceWorker", response.WasFetchedViaServiceWorker());
+  record.Set("bodyRepresentation", "decoded-browser-bytes");
+  v8trace_browser::Http(std::move(record));
+}
+inline void Reuse(uint64_t id, uint64_t original) {
+  const auto& state = Current(id, "memory-cache"); if (state.id.empty()) return;
+  base::DictValue record; record.Set("kind", "reuse-resource"); record.Set("requestId", state.id);
+  record.Set("sourceIdentifier", base::NumberToString(original)); v8trace_browser::Http(std::move(record));
+}
+inline void Data(uint64_t id, const char* layer, base::span<const char> bytes) {
+  if (!Enabled()) return;
+  auto& state = Current(id, layer); if (state.id.empty() || state.pipe) return;
+  v8trace_browser::Chunk(state.id, "response", state.bytes, base::as_bytes(bytes), layer);
+  state.bytes += bytes.size();
+}
+inline void Finish(uint64_t id, const char* layer, int64_t expected, bool success) {
+  if (!Enabled()) return;
+  auto& state = Current(id, layer); if (state.id.empty()) return;
+  base::DictValue record;
+  record.Set("kind", "complete"); record.Set("requestId", state.id);
+  record.Set("success", success); record.Set("bytes", base::NumberToString(state.bytes));
+  record.Set("pipe", state.pipe);
+  record.Set("expectedDecodedBytes", base::NumberToString(expected));
+  v8trace_browser::Http(std::move(record));
+  States().erase(Key(id, layer));
+}
+}
