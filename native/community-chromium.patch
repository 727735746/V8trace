+#ifndef BASE_TRACE_EVENT_V8TRACE_BROWSER_RECORD_H_
+#define BASE_TRACE_EVENT_V8TRACE_BROWSER_RECORD_H_
+
+#include <algorithm>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <unordered_map>
+#include "base/base64.h"
+#include "base/json/json_writer.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/trace_event/trace_event.h"
+#include "base/values.h"
+
+namespace v8trace_browser {
+inline bool Enabled(const char* category) {
+  const perfetto::DynamicCategory dynamic_category(category);
+  return TRACE_EVENT_CATEGORY_ENABLED(dynamic_category);
+}
+inline std::string Address(const void* pointer) {
+  return base::NumberToString(reinterpret_cast<uintptr_t>(pointer));
+}
+inline bool Emit(const char* category, const char* channel, base::DictValue record) {
+  const perfetto::DynamicCategory dynamic_category(category);
+  bool accepted = false;
+  TRACE_EVENT_INSTANT(dynamic_category, "V8TraceBrowser",
+      [&](perfetto::EventContext context) {
+        static thread_local std::unordered_map<std::string, uint64_t> sequences;
+        record.Set("schema", "v8trace/browser/1");
+        record.Set("channel", channel);
+        record.Set("producer", "chromium");
+        record.Set("producerEdition", "community");
+        record.Set("producerEditionProtocol", "v8trace/browser-edition/1");
+        record.Set("producerSeq", base::NumberToString(++sequences[channel]));
+        std::string json;
+        if (base::JSONWriter::Write(record, &json)) { context.AddDebugAnnotation("record", json); accepted = true; }
+      });
+  return accepted;
+}
+inline void Http(base::DictValue record) {
+  Emit("disabled-by-default-v8.http", "http", std::move(record));
+}
+inline void Chunk(const std::string& id, const char* direction, uint64_t offset,
+                  base::span<const uint8_t> bytes, const char* layer) {
+  if (!Enabled("disabled-by-default-v8.http") || bytes.empty()) return;
+  while (!bytes.empty()) {
+    auto part = bytes.first(std::min<size_t>(bytes.size(), 32768));
+    base::DictValue record;
+    record.Set("kind", "body-chunk"); record.Set("requestId", id);
+    record.Set("direction", direction); record.Set("layer", layer);
+    record.Set("offset", base::NumberToString(offset));
+    record.Set("bytes", static_cast<int>(part.size()));
+    record.Set("base64", base::Base64Encode(part));
+    Http(std::move(record));
+    offset += part.size(); bytes = bytes.subspan(part.size());
+  }
+}
+}
+#endif
