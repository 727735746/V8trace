+#ifndef CHROME_APP_V8TRACE_LPAC_STARTUP_H_
+#define CHROME_APP_V8TRACE_LPAC_STARTUP_H_
+
+#include <windows.h>
+#include <aclapi.h>
+#include <sddl.h>
+
+#include <algorithm>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace v8trace_lpac {
+
+inline constexpr wchar_t kProtocol[] = L"v8trace/lpac-startup/1";
+inline constexpr DWORD kReadExecute = FILE_GENERIC_READ | FILE_GENERIC_EXECUTE;
+
+struct Result {
+  DWORD error = ERROR_SUCCESS;
+  std::wstring path;
+  size_t checked = 0;
+  size_t repaired = 0;
+};
+
+struct LocalFreeDeleter {
+  void operator()(void* memory) const { if (memory) ::LocalFree(memory); }
+};
+using LocalMemory = std::unique_ptr<void, LocalFreeDeleter>;
+
+inline DWORD Inspect(const std::wstring& path, bool directory, PSID sid,
+                     PSID world, PSID packages, bool repair, bool* missing) {
+  DWORD attributes = ::GetFileAttributesW(path.c_str());
+  if (attributes == INVALID_FILE_ATTRIBUTES) return ::GetLastError();
+  if (attributes & FILE_ATTRIBUTE_REPARSE_POINT) return ERROR_REPARSE_TAG_INVALID;
+  if (!!(attributes & FILE_ATTRIBUTE_DIRECTORY) != directory)
+    return ERROR_INVALID_DATA;
+  PACL acl = nullptr;
+  PSECURITY_DESCRIPTOR raw_descriptor = nullptr;
+  DWORD error = ::GetNamedSecurityInfoW(path.c_str(), SE_FILE_OBJECT,
+      DACL_SECURITY_INFORMATION, nullptr, nullptr, &acl, nullptr,
+      &raw_descriptor);
+  LocalMemory descriptor(raw_descriptor);
+  if (error != ERROR_SUCCESS) return error;
+  *missing = false;
+  if (!acl) return ERROR_SUCCESS;
+  if (!::IsValidAcl(acl)) return ERROR_INVALID_ACL;
+  DWORD allowed = 0, inheritable = 0;
+  GENERIC_MAPPING mapping = {FILE_GENERIC_READ, FILE_GENERIC_WRITE,
+                            FILE_GENERIC_EXECUTE, FILE_ALL_ACCESS};
+  for (DWORD i = 0; i < acl->AceCount; ++i) {
+    void* entry = nullptr;
+    if (!::GetAce(acl, i, &entry)) return ::GetLastError();
+    auto* header = static_cast<ACE_HEADER*>(entry);
+    if (header->AceType != ACCESS_ALLOWED_ACE_TYPE &&
+        header->AceType != ACCESS_DENIED_ACE_TYPE)
+      return ERROR_NOT_SUPPORTED;
+    auto* ace = static_cast<ACCESS_ALLOWED_ACE*>(entry);
+    PSID trustee = &ace->SidStart;
+    if (!::IsValidSid(trustee)) return ERROR_INVALID_SID;
+    DWORD mask = ace->Mask;
+    ::MapGenericMask(&mask, &mapping);
+    bool ours = ::EqualSid(trustee, sid);
+    if (header->AceFlags & INHERIT_ONLY_ACE) continue;
+    if (header->AceType == ACCESS_DENIED_ACE_TYPE &&
+        (ours || ::EqualSid(trustee, world) || ::EqualSid(trustee, packages)) &&
+        (mask & kReadExecute)) return ERROR_ACCESS_DENIED;
+    if (header->AceType == ACCESS_ALLOWED_ACE_TYPE && ours) {
+      allowed |= mask;
+      if ((header->AceFlags & (OBJECT_INHERIT_ACE | CONTAINER_INHERIT_ACE)) ==
+              (OBJECT_INHERIT_ACE | CONTAINER_INHERIT_ACE) &&
+          !(header->AceFlags & NO_PROPAGATE_INHERIT_ACE)) inheritable |= mask;
+    }
+  }
+  *missing = (allowed & kReadExecute) != kReadExecute ||
+      (directory && (inheritable & kReadExecute) != kReadExecute);
+  if (!*missing || !repair) return ERROR_SUCCESS;
+  EXPLICIT_ACCESS_W access = {};
+  access.grfAccessPermissions = kReadExecute;
+  access.grfAccessMode = GRANT_ACCESS;
+  access.grfInheritance = directory ? SUB_CONTAINERS_AND_OBJECTS_INHERIT : NO_INHERITANCE;
+  ::BuildTrusteeWithSidW(&access.Trustee, sid);
+  PACL merged = nullptr;
+  error = ::SetEntriesInAclW(1, &access, acl, &merged);
+  LocalMemory new_acl(merged);
+  if (error != ERROR_SUCCESS) return error;
+  return ::SetNamedSecurityInfoW(const_cast<wchar_t*>(path.c_str()), SE_FILE_OBJECT,
+      DACL_SECURITY_INFORMATION, nullptr, nullptr, merged, nullptr);
+}
+
+inline Result Prepare(const std::wstring& directory) {
+  Result result;
+  result.path = directory;
+  std::vector<wchar_t> buffer(32768);
+  DWORD length = ::GetFullPathNameW(directory.c_str(),
+      static_cast<DWORD>(buffer.size()), buffer.data(), nullptr);
+  if (!length || length >= buffer.size()) {
+    result.error = length ? ERROR_FILENAME_EXCED_RANGE : ::GetLastError();
+    return result;
+  }
+  std::wstring root(buffer.data(), length);
+  if (root.rfind(L"\\\\?\\", 0) != 0)
+    root = root.rfind(L"\\\\", 0) == 0 ? L"\\\\?\\UNC\\" + root.substr(2) : L"\\\\?\\" + root;
+  size_t volume_end = 7;
+  if (root.rfind(L"\\\\?\\UNC\\", 0) == 0) {
+    size_t server_end = root.find(L'\\', 8);
+    size_t share_end = server_end == std::wstring::npos ? server_end : root.find(L'\\', server_end + 1);
+    if (share_end == std::wstring::npos) { result.error = ERROR_INVALID_NAME; return result; }
+    volume_end = share_end + 1;
+  } else if (root.size() < 7 || root[5] != L':' || root[6] != L'\\') {
+    result.error = ERROR_INVALID_NAME;
+    return result;
+  }
+  while (root.size() > volume_end && root.back() == L'\\') root.pop_back();
+  if (root.size() <= volume_end) { result.error = ERROR_INVALID_NAME; return result; }
+  for (std::wstring parent = root;;) {
+    result.path = parent;
+    DWORD attributes = ::GetFileAttributesW(parent.c_str());
+    if (attributes == INVALID_FILE_ATTRIBUTES) { result.error = ::GetLastError(); return result; }
+    if (attributes & FILE_ATTRIBUTE_REPARSE_POINT) { result.error = ERROR_REPARSE_TAG_INVALID; return result; }
+    if (!(attributes & FILE_ATTRIBUTE_DIRECTORY)) { result.error = ERROR_DIRECTORY; return result; }
+    if (parent.size() <= volume_end) break;
+    parent.resize((std::max)(volume_end, parent.find_last_of(L'\\')));
+  }
+  PSID restricted = nullptr, world = nullptr, packages = nullptr;
+  bool sids_created = ::ConvertStringSidToSidW(L"S-1-15-2-2", &restricted) &&
+      ::ConvertStringSidToSidW(L"S-1-1-0", &world) &&
+      ::ConvertStringSidToSidW(L"S-1-15-2-1", &packages);
+  LocalMemory restricted_owner(restricted), world_owner(world), packages_owner(packages);
+  if (!sids_created) {
+    result.error = ::GetLastError(); return result;
+  }
+  struct Item { std::wstring path; bool directory; };
+  std::vector<Item> items = {{root, true}};
+  // Validate the entire bounded tree before the first ACL mutation.
+  for (size_t i = 0; i < items.size(); ++i) {
+    Item item = items[i];
+    result.path = item.path;
+    bool missing = false;
+    result.error = Inspect(item.path, item.directory, restricted, world,
+                           packages, false, &missing);
+    if (result.error) return result;
+    ++result.checked;
+    if (!item.directory) continue;
+    WIN32_FIND_DATAW data = {};
+    HANDLE search = ::FindFirstFileW((item.path + L"\\*").c_str(), &data);
+    if (search == INVALID_HANDLE_VALUE) {
+      result.error = ::GetLastError();
+      if (result.error == ERROR_FILE_NOT_FOUND) { result.error = 0; continue; }
+      return result;
+    }
+    do {
+      if (std::wstring(data.cFileName) == L"." || std::wstring(data.cFileName) == L"..") continue;
+      items.push_back({item.path + L"\\" + data.cFileName,
+                       !!(data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY)});
+    } while (::FindNextFileW(search, &data));
+    result.error = ::GetLastError();
+    ::FindClose(search);
+    if (result.error != ERROR_NO_MORE_FILES) return result;
+    result.error = 0;
+  }
+  for (const auto& item : items) {
+    result.path = item.path;
+    bool missing = false;
+    result.error = Inspect(item.path, item.directory, restricted, world,
