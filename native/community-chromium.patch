+#ifndef UI_BASE_IME_WIN_V8TRACE_IME_COMPAT_H_
+#define UI_BASE_IME_WIN_V8TRACE_IME_COMPAT_H_
+
+#include <windows.h>
+
+namespace v8trace_ime {
+
+class ScopedDynamicCode final {
+ public:
+  ScopedDynamicCode() noexcept {
+    DWORD error = ::GetLastError();
+    PROCESS_MITIGATION_DYNAMIC_CODE_POLICY policy{};
+    if (::GetProcessMitigationPolicy(::GetCurrentProcess(), ProcessDynamicCodePolicy,
+            &policy, sizeof(policy)) && policy.ProhibitDynamicCode && policy.AllowThreadOptOut &&
+        ::GetThreadInformation(::GetCurrentThread(), ThreadDynamicCodePolicy,
+            &prior_, sizeof(prior_)) && !(prior_ & THREAD_DYNAMIC_CODE_ALLOW)) {
+      DWORD allow = prior_ | THREAD_DYNAMIC_CODE_ALLOW;
+      changed_ = !!::SetThreadInformation(::GetCurrentThread(), ThreadDynamicCodePolicy,
+          &allow, sizeof(allow));
+    }
+    ::SetLastError(error);
+  }
+
+  ScopedDynamicCode(const ScopedDynamicCode&) = delete;
+  ScopedDynamicCode& operator=(const ScopedDynamicCode&) = delete;
+
+  ~ScopedDynamicCode() noexcept {
+    DWORD error = ::GetLastError();
+    if (changed_ && !::SetThreadInformation(::GetCurrentThread(), ThreadDynamicCodePolicy,
+            &prior_, sizeof(prior_))) {
+      ::RaiseFailFastException(nullptr, nullptr, 0);
+    }
+    ::SetLastError(error);
+  }
+
+ private:
+  DWORD prior_ = 0;
+  bool changed_ = false;
+};
+
+}  // namespace v8trace_ime
+
+#endif
