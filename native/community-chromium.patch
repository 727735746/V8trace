+#ifndef NET_BASE_V8TRACE_UPLOAD_H_
+#define NET_BASE_V8TRACE_UPLOAD_H_
+
+#include "base/trace_event/v8trace-browser-record.h"
+#include "net/base/io_buffer.h"
+
+namespace net::v8trace_upload {
+struct State { std::string id; scoped_refptr<IOBuffer> buffer; bool ended = false; };
+inline auto& States() {
+  static thread_local std::unordered_map<const void*, State> states;
+  return states;
+}
+inline bool Enabled() { return v8trace_browser::Enabled("disabled-by-default-v8.http"); }
+inline void Init(const void* stream, uint64_t size, bool chunked, int result) {
+  if (!Enabled()) return;
+  static thread_local uint64_t attempts = 0;
+  auto& state = States()[stream];
+  state.id = "upload:" + v8trace_browser::Address(stream) + ":" + base::NumberToString(++attempts);
+  base::DictValue record; record.Set("kind", "upload-init"); record.Set("requestId", state.id);
+  record.Set("uploadStreamId", v8trace_browser::Address(stream)); record.Set("expectedBytes", base::NumberToString(size));
+  record.Set("chunked", chunked); record.Set("errorCode", result); v8trace_browser::Http(std::move(record));
+}
+inline void Read(const void* stream, IOBuffer* buffer) {
+  if (Enabled()) States()[stream].buffer = buffer;
+}
+inline void End(const void* stream, uint64_t bytes, bool complete) {
+  auto it = States().find(stream); if (it == States().end() || it->second.id.empty() || it->second.ended) return;
+  it->second.ended = true;
+  base::DictValue record; record.Set("kind", "request-body-end"); record.Set("requestId", it->second.id);
+  record.Set("bytes", base::NumberToString(bytes)); record.Set("complete", complete);
+  v8trace_browser::Http(std::move(record));
+}
+inline void Completed(const void* stream, uint64_t offset, int result, bool eof) {
+  auto it = States().find(stream); if (it == States().end()) return;
+  if (result > 0 && it->second.buffer) {
+    v8trace_browser::Chunk(it->second.id, "request", offset,
+        it->second.buffer->first(static_cast<size_t>(result)), "upload-stream");
+  }
+  it->second.buffer.reset();
+  if (eof || result < 0) End(stream, offset + std::max(result, 0), result >= 0);
+}
+inline void Reset(const void* stream, uint64_t position) {
+  End(stream, position, false); States().erase(stream);
+}
+}
+#endif
