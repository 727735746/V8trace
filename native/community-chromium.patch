+namespace blink::v8trace_idb {
+inline base::DictValue Key(const IDBKey* key, const std::string& operation, const std::string& field) {
+  base::DictValue output; output.Set("type", "indexeddb-key");
+  if (!key) { output.Set("null", true); return output; }
+  output.Set("keyType", static_cast<int>(key->GetType()));
+  switch (key->GetType()) {
+    case mojom::IDBKeyType::String: output.Set("value", v8trace_state::Text("indexeddb", operation, field.c_str(), key->GetString())); break;
+    case mojom::IDBKeyType::Binary: output.Set("value", ::v8trace_state::Bytes("indexeddb", operation, field.c_str(), base::as_byte_span(key->Binary()->data))); break;
+    case mojom::IDBKeyType::Number: case mojom::IDBKeyType::Date: {
+      double number = key->GetType() == mojom::IDBKeyType::Number ? key->Number() : key->Date();
+      std::array<uint8_t, sizeof(double)> bytes; std::memcpy(bytes.data(), &number, bytes.size());
+      output.Set("float64NativeEndian", ::v8trace_state::Bytes("indexeddb", operation, field.c_str(), base::span(bytes))); break;
+    }
+    case mojom::IDBKeyType::Array: {
+      base::ListValue array; size_t index = 0; for (const auto& value : key->Array()) array.Append(Key(value.get(), operation, field + '/' + base::NumberToString(index++))); output.Set("values", std::move(array)); break;
+    }
+    default: break;
+  }
+  return output;
+}
+inline base::DictValue Range(const IDBKeyRange* range, const std::string& operation) {
+  base::DictValue output; if (!range) { output.Set("null", true); return output; }
+  output.Set("lower", Key(range->Lower(), operation, "lower")); output.Set("upper", Key(range->Upper(), operation, "upper")); output.Set("lowerOpen", range->lowerOpen()); output.Set("upperOpen", range->upperOpen()); return output;
+}
+inline base::DictValue Value(const IDBValue* value, const std::string& operation, const std::string& field) {
+  base::DictValue output; output.Set("type", "indexeddb-serialized-value");
+  if (!value) { output.Set("null", true); return output; }
+  output.Set("valueId", base::NumberToString(value->V8TraceValueId())); output.Set("wire", ::v8trace_state::Bytes("indexeddb", operation, field.c_str(), value->Data())); output.Set("wireFormat", "Blink-IndexedDB-storage-bytes-may-be-compressed");
+  output.Set("primaryKey", Key(value->PrimaryKey(), operation, field + "/primaryKey")); output.Set("externalBlobCount", base::NumberToString(value->BlobInfo().size()));
+  output.Set("externalTokenCount", base::NumberToString(value->V8TraceExternalTokenCount()));
+  output.Set("externalPayloadCoverage", value->BlobInfo().empty() ? "none" : "external-handles-not-read"); return output;
+}
+inline base::DictValue Record(ExecutionContext* context, const char* kind, IDBDatabase* database, int64_t transaction, std::string operation = "") {
+  auto output = v8trace_state::Record(context, kind, std::move(operation)); output.Set("transactionId", base::NumberToString(transaction));
+  if (database) { output.Set("connectionId", base::NumberToString(database->V8TraceConnectionId())); output.Set("connectionScope", "IDBDatabase-native-wrapper"); output.Set("databaseVersion", base::NumberToString(database->Metadata().version)); output.Set("databaseName", v8trace_state::Text("indexeddb", *output.FindString("operationId"), "databaseName", database->name())); }
+  return output;
+}
+inline base::DictValue Any(const IDBAny* value, const std::string& operation) {
+  base::DictValue output; if (!value) { output.Set("null", true); return output; }
+  output.Set("type", static_cast<int>(value->GetType()));
+  switch (value->GetType()) {
+    case IDBAny::kIntegerType: output.Set("integer", base::NumberToString(value->Integer())); break;
+    case IDBAny::kKeyType: output.Set("key", Key(value->Key(), operation, "key")); break;
+    case IDBAny::kIDBValueType: output.Set("value", Value(value->Value(), operation, "value")); break;
+    case IDBAny::kIDBValueArrayType: { base::ListValue values; size_t index = 0; for (const auto& item : value->Values()) values.Append(Value(item.get(), operation, "values/" + base::NumberToString(index++))); output.Set("values", std::move(values)); break; }
+    case IDBAny::kIDBRecordArrayType: {
+      const auto& records = value->Records(); base::ListValue values, keys, index_keys; size_t index = 0;
+      for (const auto& item : records.values) values.Append(Value(item.get(), operation, "values/" + base::NumberToString(index++))); index = 0;
+      for (const auto& item : records.primary_keys) keys.Append(Key(item.get(), operation, "keys/" + base::NumberToString(index++))); index = 0;
+      for (const auto& item : records.index_keys) index_keys.Append(Key(item.get(), operation, "indexKeys/" + base::NumberToString(index++)));
+      output.Set("values", std::move(values)); output.Set("keys", std::move(keys)); output.Set("indexKeys", std::move(index_keys)); break;
+    }
+    case IDBAny::kIDBDatabaseType: output.Set("connectionId", base::NumberToString(value->IdbDatabase()->V8TraceConnectionId())); break;
+    default: output.Set("representation", "native-result-kind"); break;
+  }
+  return output;
+}
+}
