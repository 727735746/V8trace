+    result.path = item.path;
+    bool missing = false;
+    result.error = Inspect(item.path, item.directory, restricted, world,
+                           packages, false, &missing);
+    if (!result.error && missing) result.error = ERROR_ACCESS_DENIED;
+    if (result.error) return result;
+  }
+  result.path = root;
+  return result;
+}
