+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_LOADER_FETCH_V8TRACE_HTTP_TEE_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_LOADER_FETCH_V8TRACE_HTTP_TEE_H_
+
+#include "base/functional/bind.h"
+#include "base/location.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/trace_event/v8trace-browser-record.h"
+#include "mojo/public/cpp/system/data_pipe.h"
+#include "mojo/public/cpp/system/simple_watcher.h"
+
+namespace blink::v8trace_http {
+class Tee final {
+ public:
+  static mojo::ScopedDataPipeConsumerHandle Start(mojo::ScopedDataPipeConsumerHandle source, std::string id) {
+    mojo::ScopedDataPipeProducerHandle writer;
+    mojo::ScopedDataPipeConsumerHandle reader;
+    if (mojo::CreateDataPipe(nullptr, writer, reader) != MOJO_RESULT_OK) {
+      base::DictValue gap; gap.Set("kind", "body-tee-failed"); gap.Set("requestId", id);
+      v8trace_browser::Http(std::move(gap)); return source;
+    }
+    auto* tee = new Tee(std::move(source), std::move(writer), std::move(id));
+    tee->Pump(); return reader;
+  }
+  ~Tee() = default;
+ private:
+  Tee(mojo::ScopedDataPipeConsumerHandle source, mojo::ScopedDataPipeProducerHandle writer, std::string id)
+      : source_(std::move(source)), writer_(std::move(writer)), id_(std::move(id)),
+        input_(FROM_HERE, mojo::SimpleWatcher::ArmingPolicy::MANUAL),
+        output_(FROM_HERE, mojo::SimpleWatcher::ArmingPolicy::MANUAL) {
+    input_.Watch(source_.get(), MOJO_HANDLE_SIGNAL_READABLE | MOJO_HANDLE_SIGNAL_PEER_CLOSED,
+                 MOJO_WATCH_CONDITION_SATISFIED,
+                 base::BindRepeating(&Tee::Ready, base::Unretained(this)));
+    output_.Watch(writer_.get(), MOJO_HANDLE_SIGNAL_WRITABLE | MOJO_HANDLE_SIGNAL_PEER_CLOSED,
+                  MOJO_WATCH_CONDITION_SATISFIED,
+                  base::BindRepeating(&Tee::Ready, base::Unretained(this)));
+  }
+  void Ready(MojoResult, const mojo::HandleSignalsState&) { Pump(); }
+  void End(bool complete) {
+    if (ended_) return;
+    ended_ = true; input_.Cancel(); output_.Cancel(); source_.reset(); writer_.reset();
+    base::DictValue end; end.Set("kind", "response-body-end"); end.Set("requestId", id_);
+    end.Set("bytes", base::NumberToString(offset_)); end.Set("complete", complete);
+    v8trace_browser::Http(std::move(end));
+    base::SingleThreadTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE, this);
+  }
+  void Pump() {
+    if (ended_) return;
+    for (unsigned count = 0; count < 16; ++count) {
+      base::span<const uint8_t> bytes;
+      auto read = source_->BeginReadData(MOJO_READ_DATA_FLAG_NONE, bytes);
+      if (read == MOJO_RESULT_SHOULD_WAIT) { input_.ArmOrNotify(); return; }
+      if (read != MOJO_RESULT_OK) { End(read == MOJO_RESULT_FAILED_PRECONDITION); return; }
+      size_t written = 0;
+      auto write = writer_->WriteData(bytes, MOJO_WRITE_DATA_FLAG_NONE, written);
+      if (write == MOJO_RESULT_OK) {
+        v8trace_browser::Chunk(id_, "response", offset_, bytes.first(written), "renderer-pipe");
+        offset_ += written;
+      }
+      auto end_read = source_->EndReadData(write == MOJO_RESULT_OK ? written : 0);
+      if (end_read != MOJO_RESULT_OK) { End(false); return; }
+      if (write == MOJO_RESULT_SHOULD_WAIT) { output_.ArmOrNotify(); return; }
+      if (write != MOJO_RESULT_OK) { End(false); return; }
+    }
+    input_.ArmOrNotify();
+  }
+  mojo::ScopedDataPipeConsumerHandle source_;
+  mojo::ScopedDataPipeProducerHandle writer_;
+  std::string id_;
+  uint64_t offset_ = 0;
+  bool ended_ = false;
+  mojo::SimpleWatcher input_, output_;
+};
+}
