+  }
+  void Written(bool success) {
+    busy_ = false;
+    if (!success) { LOG(ERROR) << "V8Trace recording status write failed"; state_ = "error"; timer_.Stop(); Quit(); return; }
+    if (state_ == "finished" || state_ == "error") { timer_.Stop(); Quit(); return; }
