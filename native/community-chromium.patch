+#ifndef BASE_TRACE_EVENT_V8TRACE_STATE_RECORD_H_
+#define BASE_TRACE_EVENT_V8TRACE_STATE_RECORD_H_
+#include <mutex>
+#include <vector>
+#include "base/command_line.h"
+#include "base/no_destructor.h"
+#include "base/threading/platform_thread.h"
+#include "base/trace_event/v8trace-browser-record.h"
+#include "base/trace_event/trace_id_helper.h"
+#include "base/trace_event/v8trace-state-ledger.h"
+
+namespace v8trace_state {
+inline constexpr const char* kChannels[] = {"websocket", "indexeddb", "cookie", "storage"};
+inline const char* Category(const char* channel) {
+  if (std::string_view(channel) == "websocket") return "disabled-by-default-v8.websocket";
+  if (std::string_view(channel) == "indexeddb") return "disabled-by-default-v8.indexeddb";
+  if (std::string_view(channel) == "cookie") return "disabled-by-default-v8.cookie";
+  return "disabled-by-default-v8.storage";
+}
+inline bool Enabled(const char* channel) { return v8trace_browser::Enabled(Category(channel)); }
+inline constexpr bool SupportsProcess(std::string_view type, std::string_view utility) {
+  return type.empty() || type == "renderer" || (type == "utility" && utility == "network.mojom.NetworkService");
+}
+class Session final : public perfetto::TrackEventSessionObserver {
+ public:
+  Session() { base::TrackEvent::AddSessionObserver(this); }
+  void OnStart(const perfetto::DataSourceBase::StartArgs& args) override {
+    if (!v8trace_browser::Enabled("disabled-by-default-v8.state")) return;
+    base::ListValue selected; for (auto* channel : kChannels) if (Enabled(channel)) selected.Append(channel);
+    if (selected.empty()) return;
+    std::lock_guard<std::mutex> lock(mutex_); if (owner_ != -1) return;
+    owner_ = args.internal_instance_index; ledger.Start();
+    const perfetto::DynamicCategory category("disabled-by-default-v8.state");
+    TRACE_EVENT_INSTANT(category, "V8TraceStateSession", [&](perfetto::EventContext context) {
+      base::DictValue record; record.Set("protocol", "v8trace/state-session/1"); record.Set("epoch", base::NumberToString(ledger.epoch.load())); record.Set("selected", std::move(selected)); record.Set("phase", "start");
+      std::string json; if (base::JSONWriter::Write(record, &json)) context.AddDebugAnnotation("record", json);
+    });
+  }
+  void OnStop(const perfetto::DataSourceBase::StopArgs& args) override {
+    std::lock_guard<std::mutex> lock(mutex_); if (owner_ != args.internal_instance_index) return;
+    for (const auto& producer : ledger.Stop()) {
+      const perfetto::DynamicCategory category("disabled-by-default-v8.state");
+      TRACE_EVENT_INSTANT(category, "V8TraceStateStats", [&](perfetto::EventContext context) {
+        base::DictValue record; record.Set("protocol", "v8trace/state-stats/1"); record.Set("epoch", base::NumberToString(producer.epoch)); record.Set("producerId", base::NumberToString(producer.producer_id)); record.Set("producerThreadId", base::NumberToString(producer.thread_id));
+        record.Set("final", producer.final); record.Set("attempted", base::NumberToString(producer.attempted)); record.Set("emittedEvents", base::NumberToString(producer.emitted));
+        std::string json; if (base::JSONWriter::Write(record, &json)) context.AddDebugAnnotation("record", json);
+      });
+    }
+    const perfetto::DynamicCategory category("disabled-by-default-v8.state");
+    TRACE_EVENT_INSTANT(category, "V8TraceStateSession", [&](perfetto::EventContext context) {
+      base::DictValue record; record.Set("protocol", "v8trace/state-session/1"); record.Set("epoch", base::NumberToString(ledger.epoch.load())); record.Set("phase", "stop");
+      std::string json; if (base::JSONWriter::Write(record, &json)) context.AddDebugAnnotation("record", json);
+    });
+    owner_ = -1;
+  }
+  v8trace_call_ledger::Ledger ledger;
+ private:
+  std::mutex mutex_;
+  int64_t owner_ = -1;
+};
+inline Session& CurrentSession() { static base::NoDestructor<Session> value; return *value; }
+inline void Initialize() {
+  const auto* command = base::CommandLine::ForCurrentProcess();
+  if (SupportsProcess(command->GetSwitchValueASCII("type"), command->GetSwitchValueASCII("utility-sub-type"))) CurrentSession();
+}
+inline const std::shared_ptr<v8trace_call_ledger::Producer>& Producer() {
+  auto& session = CurrentSession().ledger; static thread_local std::shared_ptr<v8trace_call_ledger::Producer> producer;
+  if (!producer || producer->epoch != session.epoch.load(std::memory_order_acquire)) producer = session.Register(base::PlatformThread::CurrentId().raw());
+  return producer;
+}
+inline bool Emit(const char* channel, base::DictValue record) {
+  if (!Enabled(channel)) return false;
+  auto producer = Producer(); v8trace_call_ledger::WriteGuard guard(CurrentSession().ledger, producer); if (!guard) return false;
+  producer->attempted.fetch_add(1, std::memory_order_relaxed); bool accepted = false;
+  const perfetto::DynamicCategory category(Category(channel));
+  TRACE_EVENT_INSTANT(category, "V8TraceState", [&](perfetto::EventContext context) {
+    record.Set("protocol", "v8trace/state/1"); record.Set("channel", channel); record.Set("producerId", base::NumberToString(producer->producer_id)); record.Set("epoch", base::NumberToString(producer->epoch));
+    record.Set("producerSeq", base::NumberToString(producer->emitted.fetch_add(1, std::memory_order_relaxed) + 1));
+    std::string json; if (base::JSONWriter::Write(record, &json)) { context.AddDebugAnnotation("record", json); accepted = true; }
+  }); return accepted;
+}
+inline base::DictValue Bytes(const char* channel, const std::string& operation, const char* field, base::span<const uint8_t> bytes) {
+  if (bytes.size() <= 1024) {
+    base::DictValue value; value.Set("type", "inline-bytes"); value.Set("base64", base::Base64Encode(bytes)); value.Set("bytes", base::NumberToString(bytes.size())); return value;
+  }
+  auto id = operation + '/' + field + '/' + base::NumberToString(base::trace_event::GetNextGlobalTraceId()); uint64_t offset = 0;
+  base::DictValue value; value.Set("type", "byte-reference"); value.Set("contentId", id); value.Set("bytes", base::NumberToString(bytes.size()));
+  while (!bytes.empty()) {
+    auto part = bytes.first(std::min<size_t>(bytes.size(), 32768)); base::DictValue chunk;
+    chunk.Set("kind", "value-chunk"); chunk.Set("contentId", id); chunk.Set("operationId", operation); chunk.Set("offset", base::NumberToString(offset)); chunk.Set("base64", base::Base64Encode(part));
+    Emit(channel, std::move(chunk)); offset += part.size(); bytes = bytes.subspan(part.size());
+  }
+  return value;
+}
+struct Operation { std::string channel, id; };
+inline std::vector<Operation>& Operations() { static thread_local std::vector<Operation> values; return values; }
+class OperationScope {
+ public:
+  OperationScope(const OperationScope&) = delete;
+  OperationScope& operator=(const OperationScope&) = delete;
+  OperationScope(bool enabled, std::string_view channel, const std::string& id) : enabled_(enabled) { if (enabled_) Operations().push_back({std::string(channel), id}); }
+  ~OperationScope() { if (enabled_) Operations().pop_back(); }
+ private:
+  bool enabled_;
+};
+inline std::string ParentOperation(std::string_view current) {
+  const auto& values = Operations();
+  for (auto it = values.rbegin(); it != values.rend(); ++it) if (it->id != current) return it->id;
+  return "";
+}
+}
