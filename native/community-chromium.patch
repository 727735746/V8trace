+#ifndef NET_URL_REQUEST_V8TRACE_REDIRECT_BODY_H_
+#define NET_URL_REQUEST_V8TRACE_REDIRECT_BODY_H_
+
+#include "base/feature_list.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "base/metrics/field_trial_params.h"
+#include "base/task/single_thread_task_runner.h"
+#include "base/timer/timer.h"
+#include "base/trace_event/v8trace-browser-record.h"
+#include "net/base/io_buffer.h"
+#include "net/base/net_errors.h"
+#include "net/base/net_export.h"
+#include "net/http/http_transaction.h"
+#include "net/http/http_response_headers.h"
+#include "net/http/http_response_info.h"
+#include "net/url_request/url_request.h"
+
+namespace net::v8trace_redirect {
+NET_EXPORT_PRIVATE BASE_DECLARE_FEATURE(kCapture);
+inline constexpr char kStateKey = 0;
+inline constexpr char kParentKey = 1;
+inline constexpr char kProtocol[] = "v8trace/redirect-body/1";
+
+struct Parent : base::SupportsUserData::Data { std::string id, url; };
+inline void BindParent(URLRequest* request, const std::string& id) {
+  auto parent = std::make_unique<Parent>(); parent->id = id; parent->url = request->url().spec();
+  request->SetUserData(&kParentKey, std::move(parent));
+}
+inline std::string ParentId(URLRequest* request) {
+  const auto* parent = static_cast<const Parent*>(request->GetUserData(&kParentKey));
+  return parent && parent->url == request->url().spec() ? parent->id : std::string();
+}
+inline void ForgetParent(URLRequest* request) { request->RemoveUserData(&kParentKey); }
+
+struct State : base::SupportsUserData::Data {
+  std::string id, url;
+};
+inline const State* Current(URLRequest* request) {
+  const auto* state = static_cast<const State*>(request->GetUserData(&kStateKey));
+  return state && state->url == request->url().spec() ? state : nullptr;
+}
+inline bool Enabled() {
+  return base::FeatureList::IsEnabled(kCapture) &&
+      v8trace_browser::Enabled("disabled-by-default-v8.http");
+}
+
+class Drain {
+ public:
+  Drain(HttpTransaction* transaction, URLRequest* request, base::OnceClosure done)
+      : transaction_(transaction), request_(request), done_(std::move(done)),
+        buffer_(base::MakeRefCounted<IOBufferWithSize>(65536)),
+        limit_(std::clamp(base::GetFieldTrialParamByFeatureAsInt(kCapture, "max_bytes", 16777216), 1, 1073741824)),
+        timeout_(std::clamp(base::GetFieldTrialParamByFeatureAsInt(kCapture, "timeout_ms", 5000), 1, 60000)) {
+    static thread_local uint64_t ordinal = 0;
+    auto state = std::make_unique<State>();
+    state->id = "redirect-body:" + v8trace_browser::Address(request) + ":" + base::NumberToString(++ordinal);
+    state->url = request->url().spec(); id_ = state->id; parent_ = ParentId(request);
+    request->SetUserData(&kStateKey, std::move(state));
+  }
+  ~Drain() {
+    timer_.Stop();
+    if (active_) EmitEnd(false, ERR_ABORTED, "cancelled");
+  }
+  bool read_pending() const { return pending_; }
+  void Start() {
+    base::DictValue record; record.Set("kind", "redirect-body-start"); record.Set("requestId", id_);
+    record.Set("bodyProtocol", kProtocol); record.Set("url", request_->url().spec());
+    record.Set("parentRequestProtocol", "v8trace/http-parent/1"); record.Set("parentRequestId", parent_);
+    record.Set("bodyRepresentation", "encoded-network-bytes"); record.Set("maxBytes", static_cast<int>(limit_)); record.Set("timeoutMs", timeout_);
+    base::DictValue response; response.Set("url", request_->url().spec()); response.Set("bodyRepresentation", "encoded-network-bytes");
+    if (const auto* headers = transaction_->GetResponseInfo()->headers.get()) {
+      response.Set("status", headers->response_code()); response.Set("statusText", headers->GetStatusText()); response.Set("rawHeaders", headers->raw_headers());
+      base::DictValue fields; base::ListValue pairs; size_t iterator = 0; std::string name, value;
+      while (headers->EnumerateHeaderLines(&iterator, &name, &value)) {
+        fields.Set(name, value); base::DictValue pair; pair.Set("name", name); pair.Set("value", value); pairs.Append(std::move(pair));
+      }
+      response.Set("headers", std::move(fields)); response.Set("headerPairs", std::move(pairs));
+    }
+    record.Set("response", std::move(response));
+    v8trace_browser::Http(std::move(record));
+    timer_.Start(FROM_HERE, base::Milliseconds(timeout_),
+        base::BindOnce(&Drain::Finish, weak_factory_.GetWeakPtr(), ERR_TIMED_OUT, "timeout"));
+    if (request_->method() == "HEAD") { Finish(OK, "eof"); return; }
+    Read();
+  }
+
+ private:
+  void Read() {
+    if (!active_) return;
+    pending_ = true;
+    const int count = static_cast<int>(std::min<uint64_t>(buffer_->size(), limit_ - bytes_ + 1));
+    const int result = transaction_->Read(buffer_.get(), count,
+        base::BindOnce(&Drain::DidRead, weak_factory_.GetWeakPtr()));
+    if (result != ERR_IO_PENDING) DidRead(result);
+  }
+  void DidRead(int result) {
+    pending_ = false;
+    if (!active_) return;
+    if (result <= 0) { Finish(result, result == 0 ? "eof" : "read-error"); return; }
+    const size_t count = static_cast<size_t>(std::min<uint64_t>(result, limit_ - bytes_));
+    v8trace_browser::Chunk(id_, "response", bytes_, buffer_->first(count), "redirect-drain");
+    bytes_ += count;
+    if (static_cast<size_t>(result) > count) { Finish(ERR_FILE_TOO_BIG, "byte-budget"); return; }
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+        base::BindOnce(&Drain::Read, weak_factory_.GetWeakPtr()));
+  }
+  void EmitEnd(bool complete, int error, const char* reason) {
+    base::DictValue record; record.Set("kind", "response-body-end"); record.Set("requestId", id_);
+    record.Set("bodyProtocol", kProtocol); record.Set("complete", complete);
+    record.Set("bytes", base::NumberToString(bytes_)); record.Set("errorCode", error); record.Set("reason", reason);
+    v8trace_browser::Http(std::move(record));
+  }
+  void Finish(int error, const char* reason) {
+    if (!active_) return;
+    active_ = false; timer_.Stop(); EmitEnd(error == OK, error, reason);
+    auto done = std::move(done_); std::move(done).Run();
+  }
+  raw_ptr<HttpTransaction> transaction_;
+  raw_ptr<URLRequest> request_;
+  base::OnceClosure done_;
+  scoped_refptr<IOBufferWithSize> buffer_;
+  std::string id_, parent_;
+  uint64_t bytes_ = 0;
+  uint64_t limit_;
+  int timeout_;
+  bool active_ = true;
+  bool pending_ = false;
+  base::OneShotTimer timer_;
+  base::WeakPtrFactory<Drain> weak_factory_{this};
+};
+}
+#endif
