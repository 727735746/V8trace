+inline bool FilterGlob(std::u16string_view value, std::u16string_view pattern) {
+  size_t v = 0, p = 0, star = std::u16string_view::npos, retry = 0;
+  while (v < value.size()) {
+    if (p < pattern.size() && (pattern[p] == u'?' || pattern[p] == value[v])) { ++p; ++v; }
+    else if (p < pattern.size() && pattern[p] == u'*') { star = p++; retry = v; }
+    else if (star != std::u16string_view::npos) { p = star + 1; v = ++retry; }
+    else return false;
+  }
+  while (p < pattern.size() && pattern[p] == u'*') ++p;
+  return p == pattern.size();
+}
+inline bool FilterAny(std::u16string_view value, const std::vector<std::u16string>& patterns,
+                      bool script = false) {
+  for (const auto& pattern : patterns) {
+    auto candidate = value;
+    if (script && pattern.find(u'/') == std::u16string::npos) {
+      candidate = candidate.substr(0, candidate.find_first_of(u"?#"));
+      auto slash = candidate.find_last_of(u'/');
+      if (slash != std::u16string_view::npos) candidate.remove_prefix(slash + 1);
+    }
+    if (FilterGlob(candidate, pattern)) return true;
+  }
+  return false;
+}
+inline DetailFilterConfig ParseDetailFilter(const char* raw) {
+    DetailFilterConfig result;
+    if (!raw || !*raw) return result;
+    result.active = true; result.token = raw;
+    if (result.token.size() > 65536 ||
+        (!result.token.starts_with("1;") && !result.token.starts_with("2;"))) { result.valid = false; return result; }
+    auto hex = [](char ch) -> int { return ch >= '0' && ch <= '9' ? ch - '0' : ch >= 'a' && ch <= 'f' ? ch - 'a' + 10 : -1; };
+    size_t cursor = 2, rules = 0;
+    while (cursor < result.token.size()) {
+      auto end = result.token.find(';', cursor);
+      if (end == std::string::npos) { result.valid = false; break; }
+      auto item = std::string_view(result.token).substr(cursor, end - cursor); cursor = end + 1;
+      if (item.starts_with("K=")) {
+        if (item.size() < 3) { result.valid = false; break; }
+        result.kinds = 0;
+        for (char ch : item.substr(2)) {
+          if (ch < '0' || ch > '9' || result.kinds > 127) { result.valid = false; break; }
+          result.kinds = result.kinds * 10 + ch - '0';
+        }
+        if (result.kinds > 127) result.valid = false;
+        continue;
+      }
+      if (item == "U=0" || item == "U=1") { result.unknown = item.back() == '1'; continue; }
+      if (item == "X=0" || item == "X=1") { result.exclude_internal = item.back() == '1'; continue; }
+      std::vector<std::u16string>* target = nullptr;
+      if (item.starts_with("S+=")) target = &result.scripts_include;
+      if (item.starts_with("S-=")) target = &result.scripts_exclude;
+      if (item.starts_with("J+=")) target = &result.functions_include;
+      if (item.starts_with("J-=")) target = &result.functions_exclude;
+      if (item.starts_with("N+=")) target = &result.native_include;
+      if (item.starts_with("N-=")) target = &result.native_exclude;
+      if (result.token.starts_with("2;")) {
+        if (item.starts_with("D+=")) target = &result.value_scripts_include;
+        if (item.starts_with("D-=")) target = &result.value_scripts_exclude;
+        if (item.starts_with("F+=")) target = &result.value_functions_include;
+        if (item.starts_with("F-=")) target = &result.value_functions_exclude;
+      }
+      if (!target || item.size() <= 3 || (item.size() - 3) % 4 || ++rules > 128 || item.size() > 8195) { result.valid = false; break; }
