+    out << "{\"depth\":" << scopes - 1 << ",\"scopeType\":\"" << ToString(info->scope_type()) << "\",\"address\":"; Pointer(out, context->address());
+    out << ",\"identityScope\":\"address-at-observation\",\"sourceStart\":" << (info->HasPositionInfo() ? info->StartPosition() : -1)
+        << ",\"sourceEnd\":" << (info->HasPositionInfo() ? info->EndPosition() : -1) << ",\"declaredContextLocals\":" << info->ContextLocalCount() << ",\"bindings\":[";
+    bool binding_comma = false;
+    for (auto local : ScopeInfo::IterateLocalNames(info, no_gc)) {
+      if (bindings >= v8_flags.trace_closure_bindings) { complete = false; break; }
+      int index = local->index(), slot = info->ContextHeaderLength() + index;
+      if (binding_comma) out << ','; binding_comma = true; ++bindings;
+      out << "{\"name\":"; Value(out, isolate, local->name()); out << ",\"slot\":" << slot << ",\"mode\":" << static_cast<int>(info->ContextLocalMode(index)) << ",\"initialization\":" << static_cast<int>(info->ContextLocalInitFlag(index)) << ",\"value\":";
+      if (slot < 0 || slot >= context->length()) { out << "{\"type\":\"unavailable\",\"reason\":\"slot-out-of-range\"}"; complete = false; }
+      else ClosureValue(out, isolate, context->elements()[slot].Relaxed_Load(), observer);
+      out << '}';
+    }
+    if (info->HasContextAllocatedFunctionName()) {
+      if (bindings >= v8_flags.trace_closure_bindings) complete = false;
+      else {
+        if (binding_comma) out << ','; ++bindings;
+        int slot = info->FunctionContextSlotIndex();
+        out << "{\"name\":"; Value(out, isolate, info->FunctionName()); out << ",\"role\":\"function-name\",\"mode\":-1,\"slot\":" << slot << ",\"value\":";
+        if (slot < 0 || slot >= context->length()) { out << "{\"type\":\"unavailable\",\"reason\":\"slot-out-of-range\"}"; complete = false; }
+        else ClosureValue(out, isolate, context->elements()[slot].Relaxed_Load(), observer);
+        out << '}';
+      }
