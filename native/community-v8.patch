+#ifndef V8_RUNTIME_V8TRACE_OPCODE_H_
+#define V8_RUNTIME_V8TRACE_OPCODE_H_
+#include "src/runtime/v8trace-values.h"
+#include "src/runtime/v8trace-sha256.h"
+namespace v8::internal::v8trace {
+inline std::string BytecodeIdentity(Tagged<BytecodeArray> bytes) {
+  using interpreter::Bytecode;
+  using interpreter::Bytecodes;
+  using interpreter::OperandScale;
+  v8trace_sha256::Hash hash;
+  for (int offset = 0; offset < bytes->length();) {
+    auto raw = bytes->get(offset);
+    if (raw > static_cast<uint8_t>(Bytecode::kLast)) return {};
+    auto opcode = Bytecodes::FromByte(raw);
+    auto scale = OperandScale::kSingle;
+    if (Bytecodes::IsPrefixScalingBytecode(opcode)) {
+      scale = Bytecodes::PrefixBytecodeToOperandScale(opcode);
+      hash.Add(raw);
+      if (++offset >= bytes->length()) return {};
+      raw = bytes->get(offset);
+      if (raw > static_cast<uint8_t>(Bytecode::kLast)) return {};
+      opcode = Bytecodes::FromByte(raw);
+      if (Bytecodes::IsPrefixScalingBytecode(opcode)) return {};
+    }
+    int size = Bytecodes::Size(opcode, scale);
+    if (size <= 0 || size > bytes->length() - offset) return {};
+    for (int i = 0; i < size; ++i) {
+      bool feedback = false;
+      for (int n = 0; n < Bytecodes::NumberOfOperands(opcode); ++n)
+        if (Bytecodes::GetOperandType(opcode, n) == interpreter::OperandType::kEmbeddedFeedback &&
+            Bytecodes::GetOperandOffset(opcode, n, scale) == i) feedback = true;
+      // Embedded feedback changes during execution; raw Opcode bytes stay intact.
+      hash.Add(feedback ? 0 : bytes->get(offset + i));
+    }
+    offset += size;
+  }
+  return hash.Finish();
+}
+inline void Record(Isolate*, UnoptimizedJSFrame*, Handle<BytecodeArray>,
+                   interpreter::BytecodeArrayIterator&, int, Handle<Object>, bool) {}
+}
