+}
+inline bool JsSelected(Isolate* isolate, Tagged<JSFunction> function) {
+  const auto& config = DetailFilter(); if (!config.active) return true;
+  const auto& source = FunctionSource(isolate, function);
+  return FilterDecision(source.selected, 0, source.known);
+}
+inline bool NativeSelected(Isolate* isolate, NativeKind kind, std::u16string_view name) {
+  const auto& config = DetailFilter(); if (!config.active) return true;
+  const auto& source = CurrentSource(isolate);
+  return FilterDecision(config.valid && (config.kinds & static_cast<uint32_t>(kind)) && (source.function_id ? source.source_selected : SourceSelected(source)) &&
