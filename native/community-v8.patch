+#ifndef V8_RUNTIME_V8TRACE_CALL_STATS_H_
+#define V8_RUNTIME_V8TRACE_CALL_STATS_H_
+
+#include "src/base/platform/platform.h"
+#include "src/runtime/v8trace-call-ledger.h"
+
+namespace v8::internal::v8trace {
+using CallProducerStats = v8trace_call_ledger::Producer;
+inline v8trace_call_ledger::Ledger& CallSession() { static v8trace_call_ledger::Ledger state; return state; }
+inline const std::shared_ptr<CallProducerStats>& SharedCallStats() {
+  auto& session = CallSession();
+  static thread_local std::shared_ptr<CallProducerStats> producer;
+  auto epoch = session.epoch.load(std::memory_order_acquire);
+  if (!producer || producer->epoch != epoch) producer = session.Register(base::OS::GetCurrentThreadId());
+  return producer;
+}
+inline CallProducerStats& CallStats() { return *SharedCallStats(); }
+class CallWriteGuard : public v8trace_call_ledger::WriteGuard {
+ public:
+  CallWriteGuard() : WriteGuard(CallSession(), SharedCallStats()) {}
+};
+struct CallTraceOwner { std::mutex mutex; int64_t instance = -1; };
+inline CallTraceOwner& CallOwner() { static CallTraceOwner owner; return owner; }
+void DetailSessionStart(uint32_t instance) {
+  bool enabled = false;
+  TRACE_EVENT_CATEGORY_GROUP_ENABLED(TRACE_DISABLED_BY_DEFAULT("v8.jscall"), &enabled);
+  if (!v8_flags.trace_jscall_detail || !enabled) return;
+  auto& owner = CallOwner(); std::lock_guard<std::mutex> lock(owner.mutex);
+  if (owner.instance != -1) return;
+  owner.instance = instance; CallSession().Start();
+}
+void EmitCallSessionStop() {
+  for (const auto& producer : CallSession().Stop()) {
+#if defined(V8_USE_PERFETTO)
+    TRACE_EVENT_INSTANT(TRACE_DISABLED_BY_DEFAULT("v8.jscall"), "V8TraceCallStats",
+        [&](perfetto::EventContext context) {
+          context.AddDebugAnnotation("protocol", "v8trace/call-stats/1");
+          context.AddDebugAnnotation("producerThreadId", producer.thread_id);
+          context.AddDebugAnnotation("producerId", std::to_string(producer.producer_id));
+          context.AddDebugAnnotation("epoch", producer.epoch);
+          context.AddDebugAnnotation("final", producer.final);
+          context.AddDebugAnnotation("attemptedCalls", producer.attempted);
+          context.AddDebugAnnotation("selectedCalls", producer.selected);
+          context.AddDebugAnnotation("filteredCalls", producer.filtered);
+          context.AddDebugAnnotation("emittedEvents", producer.emitted);
+        });
+#endif
+  }
+}
+void DetailSessionStop(uint32_t instance) {
+  auto& owner = CallOwner(); std::lock_guard<std::mutex> lock(owner.mutex);
+  if (owner.instance != instance) return;
+  EmitCallSessionStop(); owner.instance = -1;
+}
+void DetailSessionShutdown() {
+  auto& owner = CallOwner(); std::lock_guard<std::mutex> lock(owner.mutex);
+  if (owner.instance == -1) return;
+  EmitCallSessionStop(); owner.instance = -1;
+}
+}
+#endif
