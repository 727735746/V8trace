+#ifndef V8_RUNTIME_V8TRACE_NODE_IDS_H_
+#define V8_RUNTIME_V8TRACE_NODE_IDS_H_
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <unordered_map>
+
+namespace v8trace_snapshot {
+
+class NodeIds {
+ public:
+  uint32_t Find(uintptr_t address) const {
+    if (promoted_) {
+      auto found = promoted_->find(address);
+      return found == promoted_->end() ? 0 : found->second;
+    }
+    for (uint32_t i = 0; i < inline_size_; ++i) {
+      if (inline_nodes_[i].address == address) return inline_nodes_[i].id;
+    }
+    return 0;
+  }
+  uint32_t InsertNew(uintptr_t address) {
+    uint32_t id = size() + 1;
+    if (!promoted_ && inline_size_ < inline_nodes_.size()) {
+      inline_nodes_[inline_size_++] = {address, id};
+    } else {
+      if (!promoted_) {
+        promoted_.emplace();
+        promoted_->reserve(64);
+        for (uint32_t i = 0; i < inline_size_; ++i)
+          promoted_->emplace(inline_nodes_[i].address, inline_nodes_[i].id);
+      }
+      promoted_->emplace(address, id);
+    }
+    return id;
+  }
+  uint32_t size() const { return promoted_ ? static_cast<uint32_t>(promoted_->size()) : inline_size_; }
+
+ private:
+  struct Node { uintptr_t address; uint32_t id; };
+  std::array<Node, 8> inline_nodes_;
+  uint32_t inline_size_ = 0;
+  std::optional<std::unordered_map<uintptr_t, uint32_t>> promoted_;
+};
+
+}
+#endif
