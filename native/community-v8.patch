+extern "C" __declspec(dllimport) wchar_t* __stdcall GetCommandLineW();
+#endif
+
+namespace v8::internal::v8trace {
+
+struct ObjectObservationConfig {
+  uint32_t depth, nodes, properties;
+  static uint32_t Read(const char* name, const wchar_t* flag, uint32_t maximum) {
+#ifdef V8_OS_WIN
+    std::wstring_view command(GetCommandLineW()), token(flag);
+    size_t position = command.find(token);
+    while (position != std::wstring_view::npos) {
+      if (!position || command[position - 1] == L' ' || command[position - 1] == L'\t' || command[position - 1] == L'"') {
+        size_t cursor = position + token.size(), start = cursor;
+        uint32_t number = 0;
+        while (cursor < command.size() && command[cursor] >= L'0' && command[cursor] <= L'9') {
+          uint32_t digit = command[cursor++] - L'0';
+          if (digit > maximum || number > (maximum - digit) / 10) return 0;
+          number = number * 10 + digit;
+        }
+        if (cursor == start || number > maximum || (cursor != command.size() && command[cursor] != L' ' && command[cursor] != L'\t' && command[cursor] != L'"')) return 0;
+        return number;
+      }
+      position = command.find(token, position + token.size());
+    }
+    return 0;
+#else
+    const char* value = std::getenv(name);
+    if (!value || !*value) return 0;
+    char* end = nullptr;
+    unsigned long number = std::strtoul(value, &end, 10);
+    return *end || number > maximum ? 0 : static_cast<uint32_t>(number);
+#endif
+  }
+  bool enabled() const { return depth && nodes && properties; }
+};
+
+inline const ObjectObservationConfig& ObservationConfig() {
+  static const ObjectObservationConfig config = {
+      ObjectObservationConfig::Read("V8_TRACE_OBJECT_DEPTH", L"--v8-trace-object-depth=", 8),
+      ObjectObservationConfig::Read("V8_TRACE_OBJECT_NODES", L"--v8-trace-object-nodes=", 4096),
+      ObjectObservationConfig::Read("V8_TRACE_OBJECT_PROPERTIES", L"--v8-trace-object-properties=", 65536)};
+  return config;
+}
+
+inline void ObservationConfigJson(std::ostream& out) {
+  const auto& config = ObservationConfig();
+  out << "{\"schema\":\"v8trace/objects/1\",\"enabled\":"
+      << (config.enabled() ? "true" : "false") << ",\"depth\":" << config.depth
+      << ",\"nodes\":" << config.nodes << ",\"properties\":" << config.properties
+      << ",\"scanLimit\":" << config.properties * 16
+      << ",\"invokesGetters\":false,\"invokesProxyTraps\":false}";
+}
+
+class ObjectObservation {
+ public:
+  explicit ObjectObservation(Isolate* isolate) : isolate_(isolate), config_(ObservationConfig()) {}
+  ObjectObservation(Isolate* isolate, const ObjectObservationConfig& config) : isolate_(isolate), config_(config) {}
+  void Write(std::ostream& out, Tagged<Object> value, uint32_t depth = 0) {
+    if (OutsideObjectCage(isolate_, value)) {
+      ExternalHeapReference(out, value);
+      return;
+    }
+    if (!IsHeapObject(value) || IsString(value) || IsNumber(value) ||
+        IsBigInt(value) || IsOddball(value) || IsTheHole(value)) {
+      Value(out, isolate_, value);
+      return;
+    }
+    auto heap = Cast<HeapObject>(value);
+    out << "{\"type\":\"heap-reference\",\"address\":";
+    Pointer(out, heap->address());
+    out << ",\"instanceType\":" << v8trace_json::Number(static_cast<unsigned>(heap->map()->instance_type()))
+        << ",\"identityScope\":\"address-at-observation\",\"snapshot\":{\"schema\":\"v8trace/objects/1\"";
+    uint32_t found = visited_.Find(heap->address());
+    if (found) {
+      out << ",\"refNodeId\":" << v8trace_json::Number(found) << "}}";
+      return;
+    }
+    if (depth > config_.depth || visited_.size() >= config_.nodes) {
+      out << ",\"coverage\":\"partial\",\"reason\":\""
+          << (depth > config_.depth ? "depth-budget" : "node-budget") << "\"}}";
+      return;
+    }
+    uint32_t id = visited_.InsertNew(heap->address());
+    out << ",\"nodeId\":" << v8trace_json::Number(id) << ",\"identityScope\":\"value-graph-at-observation\"";
+    if (IsSymbol(value)) {
+      out << ",\"kind\":\"symbol\",\"description\":";
+      Value(out, isolate_, Cast<Symbol>(value)->description());
+      out << ",\"coverage\":\"symbol-description\"}}";
+      return;
+    }
+    if (IsJSFunction(value)) {
+      auto shared = Cast<JSFunction>(value)->shared();
+      out << ",\"kind\":\"function\",\"name\":";
+      JsonString(out, shared->Name());
+      out << ",\"functionStart\":" << v8trace_json::Number(shared->StartPosition()) << ",\"scriptId\":";
+      if (IsScript(shared->script())) out << v8trace_json::Number(Cast<Script>(shared->script())->id()); else out << "null";
+      out << ",\"apiFunction\":" << (shared->IsApiFunction() ? "true" : "false")
+          << ",\"coverage\":\"function-metadata\"}}";
+      return;
+    }
+    if (IsJSProxy(value)) {
+      out << ",\"kind\":\"proxy\",\"coverage\":\"opaque\",\"reason\":\"proxy-not-invoked\"}}";
+      return;
+    }
+    auto type = heap->map()->instance_type();
+    if (type != JS_OBJECT_TYPE && type != JS_ARRAY_TYPE) {
+      out << ",\"coverage\":\"opaque\",\"reason\":\"internal-or-host-object\"}}";
+      return;
+    }
+    auto object = Cast<JSObject>(value);
+    auto map = object->map();
+    if (map->has_named_interceptor() || map->has_indexed_interceptor() || map->is_access_check_needed()) {
+      out << ",\"coverage\":\"opaque\",\"reason\":\"interceptor-or-access-check\"}}";
+      return;
+    }
+    out << ",\"kind\":\"" << (IsJSArray(value) ? "array" : "object") << "\",\"prototype\":";
+    Value(out, isolate_, map->prototype());
+    if (IsJSArray(value)) { out << ",\"length\":"; Value(out, isolate_, Cast<JSArray>(value)->length()); }
+    out << ",\"ownProperties\":[";
+    bool comma = false, complete = true;
+    if (object->HasFastProperties()) {
+      auto descriptors = map->instance_descriptors();
+      for (InternalIndex i : map->IterateOwnDescriptors()) {
+        if (!Consume()) { complete = false; break; }
+        auto details = descriptors->GetDetails(i);
+        auto field = details.location() == PropertyLocation::kField
+            ? object->RawFastPropertyAt(FieldIndex::ForDetails(map, details))
+            : descriptors->GetStrongValue(i);
+        Property(out, descriptors->GetKey(i), field, details, depth, comma);
+      }
+    } else if constexpr (V8_ENABLE_SWISS_NAME_DICTIONARY_BOOL) {
+      auto dictionary = object->property_dictionary_swiss();
+      for (InternalIndex i : dictionary->IterateEntries()) {
+        if (!Scan()) { complete = false; break; }
+        auto key = dictionary->KeyAt(i);
+        if (!IsName(key)) continue;
+        if (!Consume()) { complete = false; break; }
+        Property(out, key, dictionary->ValueAt(i), dictionary->DetailsAt(i), depth, comma);
+      }
+    } else {
+      auto dictionary = object->property_dictionary();
+      for (InternalIndex i : dictionary->IterateEntries()) {
+        if (!Scan()) { complete = false; break; }
+        Tagged<Object> key;
+        if (!dictionary->ToKey(i, &key)) continue;
+        if (!Consume()) { complete = false; break; }
+        Property(out, key, dictionary->ValueAt(i), dictionary->DetailsAt(i), depth, comma);
+      }
+    }
+    out << "],\"elementsKind\":" << v8trace_json::Number(static_cast<int>(object->GetElementsKind())) << ",\"elements\":[";
+    comma = false;
+    auto elements = object->elements();
+    if (IsFixedArrayExact(elements)) {
+      auto array = Cast<FixedArray>(elements);
+      uint32_t length = array->length().value();
+      if (IsJSArray(value) && IsSmi(Cast<JSArray>(value)->length()))
+        length = std::min(length, static_cast<uint32_t>(Cast<Smi>(Cast<JSArray>(value)->length()).value()));
+      for (uint32_t i = 0; i < length; ++i) {
+        if (!Scan()) { complete = false; break; }
+        auto element = array->get(i);
+        if (IsTheHole(element)) continue;
+        if (!Consume()) { complete = false; break; }
+        if (comma) out << ','; comma = true;
+        out << "{\"index\":" << v8trace_json::Number(i) << ",\"value\":";
+        Write(out, element, depth + 1); out << '}';
+      }
+    } else if (IsFixedDoubleArray(elements)) {
+      auto array = Cast<FixedDoubleArray>(elements);
+      uint32_t length = array->length().value();
+      if (IsJSArray(value) && IsSmi(Cast<JSArray>(value)->length()))
+        length = std::min(length, static_cast<uint32_t>(Cast<Smi>(Cast<JSArray>(value)->length()).value()));
+      for (uint32_t i = 0; i < length; ++i) {
+        if (!Scan()) { complete = false; break; }
+        if (array->is_the_hole(i)) continue;
+        if (!Consume()) { complete = false; break; }
+        if (comma) out << ','; comma = true;
+        #ifdef V8_ENABLE_UNDEFINED_DOUBLE
+        if (array->is_undefined(i)) {
+          out << "{\"index\":" << v8trace_json::Number(i) << ",\"value\":{\"type\":\"undefined\"}}";
+          continue;
+        }
+        #endif
+        out << "{\"index\":" << v8trace_json::Number(i) << ",\"value\":{\"type\":\"number\",\"value\":";
+        double number = array->get_scalar(i);
+        if (std::isnan(number)) out << "\"NaN\"";
+        else if (!std::isfinite(number)) out << (number < 0 ? "\"-Infinity\"" : "\"Infinity\"");
+        else if (number == 0 && std::signbit(number)) out << "\"-0\"";
+        else out << std::setprecision(17) << v8trace_json::Number(number);
+        out << "}}";
+      }
+    } else if (IsNumberDictionary(elements)) {
+      auto dictionary = Cast<NumberDictionary>(elements);
+      for (InternalIndex i : dictionary->IterateEntries()) {
+        if (!Scan()) { complete = false; break; }
+        Tagged<Object> key;
+        if (!dictionary->ToKey(i, &key)) continue;
+        if (!Consume()) { complete = false; break; }
+        Property(out, key, dictionary->ValueAt(i), dictionary->DetailsAt(i), depth, comma);
+      }
+    } else if (elements->length().value()) {
+      complete = false;
+      out << "{\"coverage\":\"opaque\",\"reason\":\"exotic-elements\"}";
+    }
+    out << "],\"ownStorageCoverage\":\"" << (complete ? "complete" : "partial")
+        << "\",\"coverage\":\"own-storage-only\",\"prototypeExpanded\":false,\"internalSlotsExpanded\":false";
+    if (!complete) out << ",\"reason\":\"property-or-scan-budget-or-exotic-elements\"";
+    out << "}}";
+  }
+
+ private:
+  bool Consume() { return properties_++ < config_.properties; }
+  bool Scan() { return scans_++ < config_.properties * 16; }
+  void Property(std::ostream& out, Tagged<Object> key, Tagged<Object> value,
+                PropertyDetails details, uint32_t depth, bool& comma) {
+    if (comma) out << ','; comma = true;
+    out << "{\"key\":"; Write(out, key, depth + 1);
+    out << ",\"attributes\":" << v8trace_json::Number(static_cast<int>(details.attributes()))
+        << ",\"kind\":\"" << (details.kind() == PropertyKind::kData ? "data" : "accessor") << '\"';
+    if (details.kind() == PropertyKind::kAccessor && IsAccessorPair(value)) {
+      auto pair = Cast<AccessorPair>(value);
+      out << ",\"getter\":"; Write(out, pair->getter(), depth + 1);
+      out << ",\"setter\":"; Write(out, pair->setter(), depth + 1);
+      out << ",\"invoked\":false";
+    } else if (details.kind() == PropertyKind::kAccessor && IsAccessorInfo(value)) {
+      out << ",\"nativeDescriptorObservation\":\"identity-only\",\"invoked\":false,\"value\":";
+      Value(out, isolate_, value);
+    } else { out << ",\"value\":"; Write(out, value, depth + 1); }
+    out << '}';
+  }
+  Isolate* isolate_;
+  const ObjectObservationConfig& config_;
+  v8trace_snapshot::NodeIds visited_;
+  uint32_t properties_ = 0, scans_ = 0;
+};
+
+inline void ObservedValue(std::ostream& out, Isolate* isolate, Tagged<Object> value) {
+  if (!ObservationConfig().enabled()) { Value(out, isolate, value); return; }
+  DisallowGarbageCollection no_gc;
+  ObjectObservation(isolate).Write(out, value);
+}
+}
+#endif
