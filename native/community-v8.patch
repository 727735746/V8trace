+      for (size_t i = 3; i < item.size(); i += 4) {
+        int a = hex(item[i]), b = hex(item[i + 1]), c = hex(item[i + 2]), d = hex(item[i + 3]);
+        if (a < 0 || b < 0 || c < 0 || d < 0) { result.valid = false; break; }
+        text.push_back(static_cast<char16_t>((a * 16 + b) | ((c * 16 + d) << 8)));
+      }
+      target->push_back(std::move(text));
+    }
+    return result;
+}
+inline const DetailFilterConfig& DetailFilter() {
+  static const auto config = ParseDetailFilter(v8_flags.trace_detail_filter);
+  return config;
+}
+inline std::u16string FilterString(Tagged<String> value) {
+  std::u16string result; result.reserve(value->length());
