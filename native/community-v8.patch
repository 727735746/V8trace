+}
+inline NativeKind ApiKind(v8::ExceptionContext type) {
+  if (type == v8::ExceptionContext::kOperation || type == v8::ExceptionContext::kConstructor) return NativeKind::kApiOperation;
+  if (type == v8::ExceptionContext::kAttributeGet) return NativeKind::kApiGet;
+  if (type == v8::ExceptionContext::kAttributeSet) return NativeKind::kApiSet;
+  return NativeKind::kApiInterceptor;
+}
+inline void FilterSourceJson(std::ostream& out, const FilterSource& source) {
+  if (!DetailFilter().active) return;
+  out << ",\"source\":{\"scriptId\":" << source.script_id << ",\"functionStart\":" << source.function_start
+      << ",\"known\":" << (source.known ? "true" : "false") << ",\"url\":" << source.url_json << '}';
+}
