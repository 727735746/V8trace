+}
+struct FilterCounters { uint64_t accepted[2] = {}, rejected[2] = {}, unknown[2] = {}; bool emitted = false; };
+inline FilterCounters& DetailFilterCounters() { static thread_local FilterCounters counters; return counters; }
+inline void FilterStatus(bool force = false) {
