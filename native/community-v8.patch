+      << ",\"gcEpoch\":" << isolate->heap()->gc_count().value()
+      << ",\"valueBudget\":{\"depth\":" << values.depth << ",\"nodes\":" << values.nodes << ",\"properties\":" << values.properties
+      << "},\"valueGraphScope\":\"whole-closure-snapshot\",\"invokesUserCode\":false,\"functionLocalsIncluded\":false,\"scopes\":[";
+  while (!IsNativeContext(context)) {
+    if (scopes >= v8_flags.trace_closure_scopes || bindings >= v8_flags.trace_closure_bindings) { complete = false; break; }
+    if (comma) out << ','; comma = true; ++scopes;
