+#ifndef V8_RUNTIME_V8TRACE_CLOSURE_H_
+#define V8_RUNTIME_V8TRACE_CLOSURE_H_
+#include <cstring>
+#include "src/objects/scope-info-inl.h"
+#include "src/runtime/v8trace-object-values.h"
+
+namespace v8::internal::v8trace {
+inline void ClosureNumber(std::ostream& out, double value) {
+  uint64_t bits; std::memcpy(&bits, &value, sizeof(bits));
+  out << "{\"type\":\"number\",\"value\":";
+  if (std::isnan(value)) out << "\"NaN\"";
+  else if (std::isinf(value)) out << (value < 0 ? "\"-Infinity\"" : "\"Infinity\"");
+  else if (value == 0 && std::signbit(value)) out << "\"-0\"";
+  else out << std::setprecision(17) << v8trace_json::Number(value);
+  out << ",\"float64Bits\":\"" << v8trace_json::Hex(bits) << "\"}";
+}
+inline void ClosureValue(std::ostream& out, Isolate* isolate, Tagged<Object> value, ObjectObservation& observer) {
+  if (!IsContextCell(value)) { observer.Write(out, value); return; }
+  auto cell = Cast<ContextCell>(value);
+  out << "{\"type\":\"context-cell\",\"state\":" << static_cast<int>(cell->state()) << ",\"value\":";
+  switch (cell->state()) {
+    case ContextCell::kConst: case ContextCell::kSmi: observer.Write(out, cell->tagged_value()); break;
+    case ContextCell::kInt32: out << "{\"type\":\"number\",\"value\":" << cell->int32_value() << '}'; break;
+    case ContextCell::kFloat64: ClosureNumber(out, cell->float64_value()); break;
+    case ContextCell::kDetached: out << "{\"type\":\"unavailable\",\"reason\":\"detached-context-cell\"}"; break;
+  }
+  out << '}';
+}
+inline void ClosureSnapshot(std::ostream& out, Isolate* isolate, Tagged<JSFunction> function, const char* timing = "current-call-phase") {
+  DisallowGarbageCollection no_gc;
