+  result.native_event_sequence = internal::v8trace::detail_sequences[1];
+  result.wasm_event_sequence = internal::v8trace::detail_sequences[2];
+  result.opcode_event_sequence = 0;
+  return result;
+}
+std::string V8TraceCallStackJSON(v8::Isolate* api) {
