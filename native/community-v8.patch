+}
+inline bool FilterDecision(bool selected, int channel, bool known) {
+  auto& counts = DetailFilterCounters();
+  (selected ? counts.accepted[channel] : counts.rejected[channel])++;
+  if (!known) counts.unknown[channel]++;
