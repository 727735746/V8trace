+    if (context->has_extension()) { out << ",\"extension\":"; observer.Write(out, context->extension()); }
+    out << '}';
+    auto previous = context->unchecked_previous();
+    if (!IsContext(previous)) { complete = false; break; }
+    context = Cast<Context>(previous);
+  }
+  out << "],\"scopesObserved\":" << scopes << ",\"bindingsObserved\":" << bindings << ",\"coverage\":\"" << (complete ? "context-allocated-chain" : "partial-budget-or-layout")
+      << "\",\"dynamicOrModuleBoundary\":" << (dynamic ? "true" : "false") << ",\"nativeGlobalExcluded\":true,\"stackAndElidedBindings\":\"not-materialized\",\"valueCacheAcrossCalls\":false}";
+}
+}
