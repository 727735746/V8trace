+#ifndef V8_RUNTIME_V8TRACE_ENV_STORAGE_H_
+#define V8_RUNTIME_V8TRACE_ENV_STORAGE_H_
+
+#include <algorithm>
+#include <string_view>
+#include <vector>
+#include "src/objects/dictionary-inl.h"
+#include "src/objects/js-function-inl.h"
+#include "src/objects/property-cell-inl.h"
+#include "src/objects/swiss-name-dictionary-inl.h"
+#include "src/runtime/v8trace-object-values.h"
+
+namespace v8::internal::v8trace {
+inline bool EnvHost(Tagged<Object> value) {
+  if (!IsHeapObject(value)) return false;
+  if (IsJSGlobalObject(value) || IsJSGlobalProxy(value) || IsJSApiObject(value) || IsJSSpecialApiObject(value)) return true;
+  if (IsJSFunction(value)) return Cast<JSFunction>(value)->shared()->IsApiFunction();
+  if (IsJSObject(value)) {
+    auto constructor = Cast<JSObject>(value)->map()->GetConstructor();
+    return IsJSFunction(constructor) && Cast<JSFunction>(constructor)->shared()->IsApiFunction();
+  }
+  return false;
+}
+
+struct EnvRawProperty {
+  Tagged<Name> key;
+  Tagged<Object> value;
+  PropertyDetails details;
+  uint32_t order;
+  bool indexed = false, symbol = false;
+  uint32_t index = 0;
+};
+struct EnvInventoryBudget {
+  uint32_t maximum, used = 0, scans = 0;
+  bool complete = true;
+  bool scan() { if (uint64_t(++scans) <= uint64_t(maximum) * 16) return true; complete = false; return false; }
+  bool take() { if (used < maximum) { ++used; return true; } complete = false; return false; }
+};
+inline std::vector<EnvRawProperty> EnvOwnStorage(Isolate* isolate, Tagged<JSObject> object, EnvInventoryBudget& budget) {
+  std::vector<EnvRawProperty> result;
+  auto append = [&](Tagged<Name> key, Tagged<Object> value, PropertyDetails details, uint32_t order) {
+    if (!budget.take()) return false;
+    EnvRawProperty property{key, value, details, order}; property.symbol = IsSymbol(key);
+    if (IsString(key)) property.indexed = Cast<String>(key)->AsArrayIndex(&property.index);
+    result.push_back(property); return true;
+  };
+  if (IsJSGlobalObject(object)) {
+    auto dictionary = Cast<JSGlobalObject>(object)->global_dictionary(kAcquireLoad);
+    for (InternalIndex index : dictionary->IterateEntries()) {
+      if (!budget.scan()) break;
+      auto value = dictionary->KeyAt(index); if (!IsPropertyCell(value)) continue;
+      auto cell = Cast<PropertyCell>(value); auto details = cell->property_details();
+      if (IsTheHole(cell->value())) continue;
+      if (!append(cell->name(), cell->value(), details, details.dictionary_index())) break;
+    }
+  } else if (object->HasFastProperties()) {
+    auto descriptors = object->map()->instance_descriptors(); uint32_t order = 0;
+    for (InternalIndex index : object->map()->IterateOwnDescriptors()) {
+      if (!budget.scan()) break;
+      auto details = descriptors->GetDetails(index);
+      auto value = details.location() == PropertyLocation::kField ? object->RawFastPropertyAt(FieldIndex::ForDetails(object->map(), details)) : descriptors->GetStrongValue(index);
+      if (!append(descriptors->GetKey(index), value, details, order++)) break;
+    }
+  } else if constexpr (V8_ENABLE_SWISS_NAME_DICTIONARY_BOOL) {
+    auto dictionary = object->property_dictionary_swiss();
+    uint32_t order = 0;
+    for (InternalIndex index : dictionary->IterateEntries()) {
+      if (!budget.scan()) break;
+      auto key = dictionary->KeyAt(index); if (!IsName(key)) continue;
+      auto details = dictionary->DetailsAt(index);
+      if (!append(Cast<Name>(key), dictionary->ValueAt(index), details, order++)) break;
+    }
+  } else {
+    auto dictionary = object->property_dictionary();
+    for (InternalIndex index : dictionary->IterateEntries()) {
+      if (!budget.scan()) break;
+      Tagged<Object> key; if (!dictionary->ToKey(index, &key) || !IsName(key)) continue;
+      auto details = dictionary->DetailsAt(index);
+      if (!append(Cast<Name>(key), dictionary->ValueAt(index), details, details.dictionary_index())) break;
+    }
+  }
+  std::stable_sort(result.begin(), result.end(), [](const auto& left, const auto& right) {
+    if (left.indexed != right.indexed) return left.indexed;
+    if (left.indexed) return left.index < right.index;
+    if (left.symbol != right.symbol) return !left.symbol;
+    return left.order < right.order;
+  });
+  return result;
+}
+inline void EnvPropertyJson(std::ostream& out, Isolate* isolate, const EnvRawProperty& property) {
+  out << "{\"key\":"; Value(out, isolate, property.key);
+  out << ",\"order\":" << property.order << ",\"kind\":\"" << (property.details.kind() == PropertyKind::kData ? "data" : "accessor")
+      << "\",\"enumerable\":" << (property.details.IsDontEnum() ? "false" : "true")
+      << ",\"configurable\":" << (property.details.IsConfigurable() ? "true" : "false")
+      << ",\"writable\":" << (property.details.kind() == PropertyKind::kAccessor ? "null" : property.details.IsReadOnly() ? "false" : "true");
+  if (IsSymbol(property.key)) { out << ",\"symbolDescription\":"; Value(out, isolate, Cast<Symbol>(property.key)->description()); }
+  out << ",\"storedValue\":";
+  Value(out, isolate, property.value);
+  if (property.details.kind() == PropertyKind::kAccessor && IsAccessorPair(property.value)) {
+    auto pair = Cast<AccessorPair>(property.value);
+    out << ",\"getter\":"; Value(out, isolate, pair->getter());
+    out << ",\"setter\":"; Value(out, isolate, pair->setter()); out << ",\"invoked\":false";
+  }
+  out << '}';
+}
+inline void EnvStorageJson(std::ostream& out, Isolate* isolate, Tagged<Object> value, EnvInventoryBudget& budget) {
+  out << "{\"object\":"; Value(out, isolate, value);
+  if (!IsJSObject(value) || IsJSProxy(value)) { out << ",\"coverage\":\"opaque\",\"invokesUserCode\":false}"; return; }
+  auto object = Cast<JSObject>(value);
+  out << ",\"prototype\":"; Value(out, isolate, object->map()->prototype());
+  out << ",\"dynamicInterceptor\":" << (object->map()->has_named_interceptor() || object->map()->has_indexed_interceptor() ? "true" : "false")
+      << ",\"accessCheck\":" << (object->map()->is_access_check_needed() ? "true" : "false")
+      << ",\"invokesGetters\":false,\"invokesProxyTraps\":false,\"elementsEnumerated\":false,\"properties\":[";
+  auto properties = EnvOwnStorage(isolate, object, budget); bool comma = false;
+  for (const auto& property : properties) { if (comma) out << ','; comma = true; EnvPropertyJson(out, isolate, property); }
+  out << "],\"coverage\":\"" << (budget.complete ? "raw-named-storage" : "partial-budget") << "\"}";
+}
+inline void EnvGlobalInventory(std::ostream& out, Isolate* isolate, uint32_t maximum) {
+  auto global = isolate->context()->native_context()->global_object(); EnvInventoryBudget budget{maximum};
+  out << ",\"global\":"; EnvStorageJson(out, isolate, global, budget);
+  out << ",\"interfaces\":["; bool comma = false;
+  auto definitions = EnvOwnStorage(isolate, global, budget);
+  for (const auto& definition : definitions) {
+    if (!IsJSFunction(definition.value)) continue;
+    auto function = Cast<JSFunction>(definition.value); auto shared = function->shared();
+    if (!shared->IsApiFunction() && !shared->HasBuiltinId()) continue;
+    if (comma) out << ','; comma = true;
+    out << "{\"name\":"; Value(out, isolate, definition.key);
+    out << ",\"apiFunction\":" << (shared->IsApiFunction() ? "true" : "false") << ",\"formalLength\":" << shared->length()
+        << ",\"statics\":"; EnvStorageJson(out, isolate, function, budget);
+    out << ",\"prototype\":";
+    if (function->has_prototype_slot() && function->has_instance_prototype()) EnvStorageJson(out, isolate, function->instance_prototype(), budget); else out << "null";
+    out << ",\"instanceCoverage\":\"observed-separately\"}";
+  }
+  out << "],\"propertyBudget\":" << budget.maximum << ",\"propertiesObserved\":" << budget.used
+      << ",\"slotsScanned\":" << budget.scans << ",\"coverage\":\"" << (budget.complete ? "declared-raw-storage" : "partial-budget")
+      << "\",\"lazyAccessorsEvaluated\":false,\"virtualPropertiesEnumerated\":false";
+}
+}
