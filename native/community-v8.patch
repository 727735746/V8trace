+#ifndef V8_RUNTIME_V8TRACE_BROWSER_H_
+#define V8_RUNTIME_V8TRACE_BROWSER_H_
+
+#include <span>
+#include <unordered_map>
+#include "src/api/api-inl.h"
+#include "src/execution/frames-inl.h"
+#include "src/runtime/v8trace-object-values.h"
+
+namespace v8::internal::v8trace {
+inline uint64_t BrowserSequence(const char* channel) {
+  static thread_local std::unordered_map<std::string, uint64_t> sequences;
+  return ++sequences[channel];
+}
+template <class Body>
+inline void BrowserEvent(const char* channel, const char* category,
+                          Isolate* isolate, Body body) {
+#if defined(V8_USE_PERFETTO)
+  const perfetto::DynamicCategory dynamic_category(category);
+  TRACE_EVENT_INSTANT(dynamic_category, "V8TraceBrowser",
+      [&](perfetto::EventContext context) {
+        DisallowGarbageCollection no_gc;
+        std::ostringstream out; out.imbue(std::locale::classic());
+        out << "{\"schema\":\"v8trace/browser/1\",\"channel\":\"" << channel
+            << "\",\"producer\":\"v8\",\"producerSeq\":\"" << BrowserSequence(channel)
+            << "\",\"isolateAddress\":\"" << reinterpret_cast<uintptr_t>(isolate)
+            << "\",\"isolateId\":\"" << std::hex << isolate->debug()->IsolateId()
+            << std::dec << "\",\"contextId\":";
+        if (!isolate->context().is_null()) {
+          auto id = isolate->context()->native_context()->debug_context_id();
+          if (IsSmi(id)) out << Cast<Smi>(id).value(); else out << "null";
+        } else out << "null";
+        out << ",\"objectObservation\":"; ObservationConfigJson(out);
+        body(out); out << '}'; context.AddDebugAnnotation("record", out.str());
+      });
+#endif
+}
+inline void BrowserScript(Isolate* isolate, Tagged<Script> script) {
+  if (!IsString(script->source())) return;
+  BrowserEvent("script", "disabled-by-default-v8.script", isolate, [&](std::ostream& out) {
+    out << ",\"kind\":\"compiled-source\",\"scriptId\":" << script->id()
+        << ",\"url\":";
+    if (IsString(script->name())) JsonString(out, Cast<String>(script->name())); else out << "\"\"";
+    out << ",\"source\":"; JsonString(out, Cast<String>(script->source()));
+    out << ",\"lineOffset\":" << script->line_offset()
+        << ",\"columnOffset\":" << script->column_offset()
+        << ",\"isModule\":" << (script->origin_options().IsModule() ? "true" : "false");
+  });
+}
+inline void BrowserCompileInput(Isolate* isolate, Tagged<String> source, Tagged<Object> name, const char* kind, bool is_module = false) {
+  BrowserEvent("script", "disabled-by-default-v8.script", isolate, [&](std::ostream& out) {
+    out << ",\"kind\":\"compile-input\",\"compilationKind\":\"" << kind << "\",\"scriptId\":null,\"url\":";
+    if (IsString(name)) JsonString(out, Cast<String>(name)); else out << "\"\"";
+    out << ",\"source\":"; JsonString(out, source);
+    out << ",\"isModule\":" << (is_module ? "true" : "false");
+  });
+}
+void BrowserConsole(v8::Isolate* api_isolate, int type,
+                           std::span<const v8::Local<v8::Value>> args) {
+  auto* isolate = reinterpret_cast<Isolate*>(api_isolate);
+  BrowserEvent("console", "disabled-by-default-v8.console", isolate, [&](std::ostream& out) {
+    out << ",\"kind\":\"console-api\",\"typeCode\":" << type << ",\"arguments\":[";
+    for (size_t i = 0; i < args.size(); ++i) {
+      if (i) out << ',';
+      ObservedValue(out, isolate, *Utils::OpenDirectHandle(*args[i]));
+    }
+    out << "],\"stackFrames\":[";
+    bool first = true;
+    for (JavaScriptStackFrameIterator it(isolate); !it.done(); it.Advance()) {
+      if (!first) out << ','; first = false;
+      auto shared = it.frame()->function()->shared();
+      out << "{\"functionName\":"; JsonString(out, shared->Name());
+      out << ",\"functionStart\":" << shared->StartPosition() << ",\"scriptId\":";
+      if (IsScript(shared->script())) out << Cast<Script>(shared->script())->id(); else out << "null";
+      out << '}';
+    }
+    out << ']';
+  });
+}
+void BrowserException(v8::Isolate* api_isolate, v8::Local<v8::Value> value,
+                             v8::Local<v8::String> message, v8::Local<v8::String> url,
+                             unsigned line, unsigned column, int script_id,
+                             v8::Local<v8::String> stack) {
+  auto* isolate = reinterpret_cast<Isolate*>(api_isolate);
+  BrowserEvent("exception", "disabled-by-default-v8.exception", isolate, [&](std::ostream& out) {
+    out << ",\"kind\":\"exception-thrown\",\"message\":";
+    JsonString(out, *Utils::OpenDirectHandle(*message));
+    out << ",\"url\":"; JsonString(out, *Utils::OpenDirectHandle(*url));
+    out << ",\"lineNumber\":" << line << ",\"columnNumber\":" << column
+        << ",\"scriptId\":" << script_id << ",\"exception\":";
+    if (value.IsEmpty()) out << "{\"type\":\"unobserved\"}";
+    else ObservedValue(out, isolate, *Utils::OpenDirectHandle(*value));
+    out << ",\"stack\":"; JsonString(out, *Utils::OpenDirectHandle(*stack));
+  });
+}
+}
