+void GenerateV8TraceNativeReturn(MacroAssembler* masm) {
+#ifdef V8_TARGET_OS_WIN
+  Label done;
+  __ cmpb(__ ExternalReferenceAsOperand(
+              ExternalReference::address_of_v8trace_native_flag(), r11), Immediate(0));
+  __ j(equal, &done);
