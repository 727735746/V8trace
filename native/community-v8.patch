+#ifndef V8_RUNTIME_V8TRACE_VALUES_H_
+#define V8_RUNTIME_V8TRACE_VALUES_H_
+
+#include <cmath>
+#include <iomanip>
+#include <locale>
+#include <sstream>
+#include <vector>
+
+#include "src/common/ptr-compr-inl.h"
+#include "src/debug/debug.h"
+#include "src/execution/isolate.h"
+#include "src/objects/bigint.h"
+#include "src/objects/contexts-inl.h"
+#include "src/objects/js-function-inl.h"
+#include "src/objects/script-inl.h"
+#include "src/objects/string-inl.h"
+#include "src/tracing/trace-event.h"
+#include "src/runtime/v8trace-json.h"
+
+namespace v8::internal {
+namespace v8trace {
+
+inline void JsonString(std::ostream& out, Tagged<String> value) {
+  DisallowGarbageCollection no_gc;
+  StringCharacterStream stream(value);
+  v8trace_json::WriteUtf16(out, value->length(), [&] { return stream.GetNext(); });
+}
+
+inline void Pointer(std::ostream& out, Address value) {
+  out << '"' << v8trace_json::Hex(value) << '"';
+}
+
+inline bool OutsideObjectCage(Isolate* isolate, Tagged<Object> value) {
+#ifdef V8_COMPRESS_POINTERS
+  return !HAS_SMI_TAG(value.ptr()) &&
+         (value.ptr() & kPtrComprCageBaseMask) != isolate->cage_base();
+#else
+  return false;
+#endif
+}
+
+inline void ExternalHeapReference(std::ostream& out, Tagged<Object> value) {
+  out << "{\"type\":\"heap-reference\",\"address\":";
+  Pointer(out, value.ptr() - kHeapObjectTag);
+  out << ",\"identityScope\":\"address-at-observation\",\"snapshot\":{"
+         "\"schema\":\"v8trace/objects/1\",\"coverage\":\"opaque\","
+         "\"reason\":\"outside-main-compression-cage\"}}";
+}
+
+inline void Value(std::ostream& out, Isolate* isolate, Tagged<Object> value) {
+  if (OutsideObjectCage(isolate, value)) {
+    ExternalHeapReference(out, value);
+    return;
+  }
+  ReadOnlyRoots roots(isolate);
+  if (IsString(value)) {
+    out << "{\"type\":\"string\",\"value\":";
+    JsonString(out, Cast<String>(value));
+    out << '}';
+  } else if (IsNumber(value)) {
+    double number = Object::NumberValue(value);
+    out << "{\"type\":\"number\",\"value\":";
+    if (std::isnan(number)) out << "\"NaN\"";
+    else if (!std::isfinite(number)) out << (number < 0 ? "\"-Infinity\"" : "\"Infinity\"");
+    else if (number == 0 && std::signbit(number)) out << "\"-0\"";
+    else out << std::setprecision(17) << v8trace_json::Number(number);
+    out << '}';
+  } else if (value == roots.true_value() || value == roots.false_value()) {
+    out << "{\"type\":\"boolean\",\"value\":"
+        << (value == roots.true_value() ? "true}" : "false}");
+  } else if (value == roots.undefined_value() || value == roots.null_value() ||
+             value == roots.the_hole_value()) {
+    out << "{\"type\":\"" << (value == roots.undefined_value() ? "undefined" :
+        value == roots.null_value() ? "null" : "hole") << "\"}";
+  } else if (IsBigInt(value)) {
+    auto bigint = Cast<BigInt>(value);
+    uint32_t count = bigint->Words64Count();
+    std::vector<uint64_t> words(count);
+    int sign = 0;
+    bigint->ToWordsArray64(&sign, &count, words.data());
+    out << "{\"type\":\"bigint\",\"negative\":" << (sign ? "true" : "false")
+        << ",\"digitBits\":64,\"digitsHex\":[";
+    for (uint32_t i = 0; i < count; ++i) {
+      if (i) out << ',';
+      out << '"' << v8trace_json::Hex(words[i]) << '"';
+    }
+    out << "],\"endianness\":\"least-significant-digit-first\"}";
+  } else {
+    out << "{\"type\":\"heap-reference\",\"address\":";
+    Pointer(out, Cast<HeapObject>(value)->address());
+    out << ",\"instanceType\":" << v8trace_json::Number(static_cast<unsigned>(Cast<HeapObject>(value)->map()->instance_type()))
+        << ",\"identityScope\":\"address-at-observation\"}";
+  }
+}
+
+
+}  // namespace v8trace
+}  // namespace v8::internal
