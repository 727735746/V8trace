+        << ",\"jscallFiltered\":" << counts.rejected[0] << ",\"nativeAccepted\":" << counts.accepted[1]
+        << ",\"nativeFiltered\":" << counts.rejected[1] << ",\"unknownSource\":" << counts.unknown[0] + counts.unknown[1] << '}';
