+struct ActiveCall { uint64_t id; std::string exception; bool resumed = false; bool values = true; int function_unique_id = -1; std::string closure_at_throw; CausalContext causal; };
+thread_local std::unordered_map<Isolate*, std::unordered_map<Address, ActiveCall>> js_calls;
+struct NativeSite { uint64_t id; int instruction; int successor; std::string exception; CausalContext causal; };
+thread_local std::unordered_map<Isolate*, std::unordered_map<Address, NativeSite>> native_sites;
+
+void Ascii(std::ostream& out, const char* value) {
+  out << '"';
+  for (const unsigned char* ch = reinterpret_cast<const unsigned char*>(value); *ch; ++ch) {
+    if (*ch == '"' || *ch == '\\') out << '\\' << static_cast<char>(*ch);
+    else if (*ch >= 32 && *ch < 127) out << static_cast<char>(*ch);
+    else out << "\\u" << std::hex << std::setw(4) << std::setfill('0')
+             << static_cast<unsigned>(*ch) << std::dec << std::setfill(' ');
+  }
+  out << '"';
+}
+void Reconcile(Isolate* isolate) {
+  reconcile_needed.erase(isolate);
+  auto& calls = js_calls[isolate];
+  auto& sites = native_sites[isolate];
+  if (calls.empty() && sites.empty()) return;
+  std::unordered_set<Address> alive;
+  for (JavaScriptStackFrameIterator it(isolate); !it.done(); it.Advance()) alive.insert(it.frame()->fp());
+  for (auto it = calls.begin(); it != calls.end();) {
+    if (alive.contains(it->first)) { ++it; continue; }
+    ActiveCall call = it->second;
+    DetailEvent(isolate, "jscall", [&](std::ostream& out) {
+      out << ",\"phase\":\"throw\",\"callId\":\"" << call.id
+          << "\",\"completionSource\":\"native-frame-unwind\",\"exception\":"
+          << (call.exception.empty() ? "{\"type\":\"unobserved\"}" : call.exception);
+      if (!call.closure_at_throw.empty()) out << ",\"closure\":" << call.closure_at_throw;
+    },call.causal);
+    it = calls.erase(it);
+  }
+  for (auto it = sites.begin(); it != sites.end();) {
+    if (alive.contains(it->first)) { ++it; continue; }
+    NativeSite call = it->second;
+    if (call.id) DetailEvent(isolate, "native", [&](std::ostream& out) {
+      out << ",\"phase\":\"throw\",\"callId\":\"" << call.id
+          << "\",\"completionSource\":\"native-frame-unwind\",\"exception\":"
+          << (call.exception.empty() ? "{\"type\":\"unobserved\"}" : call.exception);
+    },call.causal);
+    it = sites.erase(it);
+  }
+}
