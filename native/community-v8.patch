+    out << '}';
+    context.AddDebugAnnotation("record", out.str());
+    if (index == 0) CallStats().emitted.fetch_add(1, std::memory_order_relaxed);
+  };
+#if defined(V8_USE_PERFETTO)
+  if (std::strcmp(kind, "jscall") == 0) {
+    TRACE_EVENT_INSTANT(TRACE_DISABLED_BY_DEFAULT("v8.jscall"), "V8TraceDetail",
+                       [&](perfetto::EventContext context) { write(context, 0); });
+  } else if (std::strcmp(kind, "native") == 0) {
+    TRACE_EVENT_INSTANT(TRACE_DISABLED_BY_DEFAULT("v8.native"), "V8TraceDetail",
+                       [&](perfetto::EventContext context) { write(context, 1); });
+  } else {
+    TRACE_EVENT_INSTANT(TRACE_DISABLED_BY_DEFAULT("v8.wasm"), "V8TraceDetail",
+                       [&](perfetto::EventContext context) { write(context, 2); });
+  }
+#endif
+}
+
+void DetailValue(std::ostream& out, Isolate* isolate, Tagged<Object> value) {
+  ObservedValue(out, isolate, value);
+}
+
+bool JsTracingEnabled() {
+  bool enabled = false;
+  TRACE_EVENT_CATEGORY_GROUP_ENABLED(TRACE_DISABLED_BY_DEFAULT("v8.jscall"), &enabled);
+  if (!enabled || !CallSession().accepting.load(std::memory_order_acquire)) return false;
+  static thread_local uint64_t epoch = 0;
+  auto current = CallSession().epoch.load(std::memory_order_acquire);
+  if (epoch != current) { epoch = current; detail_sequences[0] = 0; js_calls.clear(); }
+  return true;
+}
+
+std::string CallHex(uint64_t value) {
+  char buffer[16];
+  auto converted = std::to_chars(buffer, buffer + sizeof(buffer), value, 16);
+  return std::string(buffer, converted.ptr);
+}
+
+template <typename Payload>
+void CallEvent(Isolate* isolate, Tagged<JSFunction> function, Address frame,
+               const char* phase, uint64_t id, bool values, uint32_t argc,
+               Payload&& payload) {
+#if defined(V8_USE_PERFETTO)
+  DisallowGarbageCollection no_gc;
+  auto& source = FunctionSource(isolate, function);
+  auto epoch = CallStats().epoch;
+  if (source.dictionary_epoch != epoch) {
+    TRACE_EVENT_INSTANT(TRACE_DISABLED_BY_DEFAULT("v8.jscall"), "V8TraceFunction",
+        [&](perfetto::EventContext context) {
+          std::ostringstream out;
+          out.imbue(std::locale::classic());
+          out << "{\"functionName\":" << source.function_json
+              << ",\"functionStart\":" << source.function_start
+              << ",\"gcEpoch\":" << source.gc_epoch
+              << ",\"scriptId\":" << source.script_id << ",\"source\":{\"known\":"
+              << (source.known ? "true" : "false") << ",\"scriptId\":" << source.script_id
+              << ",\"functionStart\":" << source.function_start << ",\"url\":" << source.url_json << "},\"functionValue\":";
+          DetailValue(out, isolate, function); out << '}';
+          context.AddDebugAnnotation("protocol", "v8trace/function/1");
+          context.AddDebugAnnotation("functionId", std::to_string(source.function_id));
+          context.AddDebugAnnotation("producerId", std::to_string(CallStats().producer_id));
+          context.AddDebugAnnotation("isolateId", CallHex(isolate->debug()->IsolateId()));
+          context.AddDebugAnnotation("metadata", out.str());
+          source.dictionary_epoch = epoch;
+        });
+  }
+  TRACE_EVENT_INSTANT(TRACE_DISABLED_BY_DEFAULT("v8.jscall"), "V8TraceCall",
+      [&](perfetto::EventContext context) {
+        DisallowGarbageCollection no_gc;
+        context.AddDebugAnnotation("protocol", "v8trace/call/2");
+        context.AddDebugAnnotation("phase", phase);
+        context.AddDebugAnnotation("callId", std::to_string(id));
+        context.AddDebugAnnotation("functionId", std::to_string(source.function_id));
+        context.AddDebugAnnotation("frameAddress", CallHex(frame));
+        context.AddDebugAnnotation("functionAddress", CallHex(function->address()));
+        context.AddDebugAnnotation("functionInstanceType", static_cast<unsigned>(function->map()->instance_type()));
+        context.AddDebugAnnotation("argc", argc);
+        if (false) {
+          auto found=js_calls[isolate].find(frame);
+          auto causal=found==js_calls[isolate].end()?CausalCurrent(isolate):found->second.causal;
+          std::ostringstream json;CausalValueJson(json,isolate,causal);
+          context.AddDebugAnnotation("causal",json.str());
+        }
+        if (std::strcmp(phase, "entry") == 0 || std::strcmp(phase, "resume") == 0) {
+          JavaScriptStackFrameIterator parent(isolate);
+          bool current = !parent.done() && parent.frame()->fp() == frame;
+          if (current) parent.Advance();
+          bool exact = current && parent.done();
+          if (current && !parent.done()) {
+            auto& calls = js_calls[isolate]; auto found = calls.find(parent.frame()->fp());
+            if (found != calls.end()) { context.AddDebugAnnotation("parentCallId", std::to_string(found->second.id)); exact = true; }
+          }
+          context.AddDebugAnnotation("parentExact", exact);
+        }
+        context.AddDebugAnnotation("isolateId", CallHex(isolate->debug()->IsolateId()));
+        context.AddDebugAnnotation("producerSeq", ++detail_sequences[0]);
+        context.AddDebugAnnotation("producerId", std::to_string(CallStats().producer_id));
+        if (!isolate->context().is_null()) {
+          auto context_id = isolate->context()->native_context()->debug_context_id();
+          if (IsSmi(context_id)) context.AddDebugAnnotation("contextId", Cast<Smi>(context_id).value());
+        }
+        context.AddDebugAnnotation("valuesCaptured", values);
+        if (std::strcmp(phase, "resume") == 0 || std::strcmp(phase, "suspend") == 0)
+          context.AddDebugAnnotation("boundary", "generator-activation-segment");
+        if (detail_sequences[0] == 1) {
+          std::ostringstream out; ObservationConfigJson(out);
+          context.AddDebugAnnotation("objectObservation", out.str());
+        }
+        if (values) {
+          std::ostringstream out; out.imbue(std::locale::classic()); out << '{';
+          payload(out); out << '}';
+          context.AddDebugAnnotation("values", out.str());
+        }
+        if (v8_flags.trace_jscall_closure) {
+          std::ostringstream out; out.imbue(std::locale::classic()); ClosureSnapshot(out, isolate, function);
+          context.AddDebugAnnotation("closure", out.str());
+        }
+        CallStats().emitted.fetch_add(1, std::memory_order_relaxed);
+      });
+#endif
+}
+
+void JsCall(Isolate* isolate, bool entry, Tagged<Object> result) {
+  if (!v8_flags.trace_jscall_detail || !JsTracingEnabled()) return;
+  CallWriteGuard guard; if (!guard) return;
+  if (reconcile_needed.contains(isolate)) Reconcile(isolate);
+  JavaScriptStackFrameIterator it(isolate);
+  if (it.done()) return;
+  auto frame = it.frame();
+  auto& calls = js_calls[isolate];
+  bool activating = entry && calls.contains(frame->fp()) && calls.at(frame->fp()).resumed &&
+      calls.at(frame->fp()).exception.empty() && calls.at(frame->fp()).function_unique_id == frame->function()->shared()->unique_id();
+  if (!entry && !calls.contains(frame->fp())) return;
+  if (entry && calls.contains(frame->fp()) && !activating) {
+    auto previous = calls.at(frame->fp());
+    DetailEvent(isolate, "jscall", [&](std::ostream& out) {
+      out << ",\"phase\":\"throw\",\"callId\":\"" << previous.id
+          << "\",\"completionSource\":\"frame-reused-after-unwind\",\"exception\":"
+          << (previous.exception.empty() ? "{\"type\":\"unobserved\"}" : previous.exception);
+      if (!previous.closure_at_throw.empty()) out << ",\"closure\":" << previous.closure_at_throw;
+    },previous.causal);
+    calls.erase(frame->fp());
+  }
+  if (entry && !activating) {
+    auto& stats = CallStats(); stats.attempted.fetch_add(1, std::memory_order_relaxed);
+    if (!JsSelected(isolate, frame->function())) { stats.filtered.fetch_add(1, std::memory_order_relaxed); return; }
+    stats.selected.fetch_add(1, std::memory_order_relaxed);
+  }
+  bool values = entry && !activating ? v8_flags.trace_jscall_values && FunctionSource(isolate, frame->function()).values_selected : calls.at(frame->fp()).values;
+  uint64_t id = entry && !activating ? ++detail_calls : calls.at(frame->fp()).id;
+  if (entry && !activating) calls[frame->fp()] = {id, {}, false, values, frame->function()->shared()->unique_id(), {}, CausalCurrent(isolate)};
+  if (activating) calls[frame->fp()].resumed = false;
+  CallEvent(isolate, frame->function(), frame->fp(), activating ? "argument" : entry ? "entry" : "return", id, values, frame->GetActualArgumentCount(), [&](std::ostream& out) {
+    if (entry) {
+      out << "\"receiver\":"; DetailValue(out, isolate, frame->receiver());
+      out << ",\"arguments\":[";
+      uint32_t count = frame->GetActualArgumentCount();
+      for (uint32_t i = 0; i < count; ++i) { if (i) out << ','; DetailValue(out, isolate, frame->GetParameter(i)); }
+      out << ']';
+    } else { out << "\"result\":"; DetailValue(out, isolate, result); }
+  });
+  if (!entry) calls.erase(frame->fp());
+}
+
+void JsInstruction(Isolate* isolate, UnoptimizedJSFrame* frame,
+                    interpreter::BytecodeArrayIterator& iterator,
+                    int offset, Tagged<Object> accumulator) {
+  if (!v8_flags.trace_jscall_detail || !JsTracingEnabled()) return;
+  CallWriteGuard guard; if (!guard) return;
+  if (iterator.current_operand_scale() != interpreter::OperandScale::kSingle &&
+      offset == iterator.current_offset()) return;
+  auto opcode = iterator.current_bytecode();
+  bool suspend = opcode == interpreter::Bytecode::kSuspendGenerator;
+  bool resume = opcode == interpreter::Bytecode::kResumeGenerator;
+  if (!suspend && !resume) return;
+  if (resume) {
+    auto& stats = CallStats(); stats.attempted.fetch_add(1, std::memory_order_relaxed);
+    if (!JsSelected(isolate, frame->function())) { stats.filtered.fetch_add(1, std::memory_order_relaxed); return; }
+    stats.selected.fetch_add(1, std::memory_order_relaxed);
+  }
+  auto& calls = js_calls[isolate];
+  if (suspend && !calls.contains(frame->fp())) return;
+  uint64_t id = suspend ? calls.at(frame->fp()).id : ++detail_calls;
+  bool values = suspend ? calls.at(frame->fp()).values : v8_flags.trace_jscall_values && FunctionSource(isolate, frame->function()).values_selected;
+  if (resume) calls[frame->fp()] = {id, {}, true, values, frame->function()->shared()->unique_id(), {}, CausalCurrent(isolate)};
+  CallEvent(isolate, frame->function(), frame->fp(), suspend ? "suspend" : "resume", id, values, frame->GetActualArgumentCount(), [&](std::ostream& out) {
+    out << "\"boundary\":\"generator-activation-segment\",\"generator\":";
+    DetailValue(out, isolate, frame->ReadInterpreterRegister(iterator.GetRegisterOperand(0).index()));
+    out << ",\"accumulator\":"; DetailValue(out, isolate, accumulator);
+  });
+  if (suspend) calls.erase(frame->fp());
+}
+
+void JsException(Isolate* isolate, Tagged<Object> exception) {
+  if (!v8_flags.trace_jscall_detail && !v8_flags.trace_native_detail) return;
+  bool capture = v8_flags.trace_native_detail;
+  for (const auto& item : js_calls[isolate]) capture = capture || item.second.values;
+  DisallowGarbageCollection no_gc;
+  std::ostringstream out;
+  out.imbue(std::locale::classic());
+  if (capture) DetailValue(out, isolate, exception);
+  else out << "{\"type\":\"not-captured\",\"reason\":\"call-structure-only\"}";
+  reconcile_needed.insert(isolate);
+  for (auto& item : js_calls[isolate]) item.second.exception = item.second.values ? out.str() : "{\"type\":\"not-captured\",\"reason\":\"call-structure-only\"}";
+  if (v8_flags.trace_jscall_closure && JsTracingEnabled()) {
+    CallWriteGuard guard;
+    if (guard) for (JavaScriptStackFrameIterator frame(isolate); !frame.done(); frame.Advance()) {
+      auto found = js_calls[isolate].find(frame.frame()->fp());
+      if (found == js_calls[isolate].end()) continue;
+      std::ostringstream lexical; lexical.imbue(std::locale::classic());
+      ClosureSnapshot(lexical, isolate, frame.frame()->function(), "throw-observation-before-unwind");
+      found->second.closure_at_throw = lexical.str();
+    }
+  }
+  for (auto& item : native_sites[isolate]) item.second.exception = out.str();
+}
+
+void NativeCallsite(Isolate* isolate, UnoptimizedJSFrame* frame,
+                    interpreter::BytecodeArrayIterator& iterator,
+                    int dispatch_offset, Tagged<Object> accumulator) {
+  if (!v8_flags.trace_native_detail) return;
+  if (reconcile_needed.contains(isolate)) Reconcile(isolate);
+  auto& pending = native_sites[isolate];
+  auto current = pending.find(frame->fp());
+  if (current != pending.end() && iterator.current_offset() != current->second.instruction) {
+    auto call = current->second;
+    bool returned = iterator.current_offset() == call.successor;
+    if (call.id) DetailEvent(isolate, "native", [&](std::ostream& out) {
+      out << ",\"phase\":\"" << (returned ? "return" : "throw")
+          << "\",\"callId\":\"" << call.id
+          << "\",\"completionSource\":\"ignition-successor\",";
+      if (returned) { out << "\"result\":"; DetailValue(out, isolate, accumulator); }
+      else out << "\"exception\":" << (call.exception.empty() ? "{\"type\":\"unobserved\"}" : call.exception);
+    },call.causal);
+    pending.erase(current);
+  }
+  if (iterator.current_operand_scale() != interpreter::OperandScale::kSingle &&
+      dispatch_offset == iterator.current_offset()) return;
+  const char* opcode = interpreter::Bytecodes::ToString(iterator.current_bytecode());
+  if (std::strncmp(opcode, "Call", 4) != 0 && std::strncmp(opcode, "Construct", 9) != 0) return;
+  auto type = interpreter::Bytecodes::GetOperandType(iterator.current_bytecode(), 0);
+  if (!interpreter::Bytecodes::IsRegisterInputOperandType(type)) return;
+  Tagged<Object> target = frame->ReadInterpreterRegister(iterator.GetRegisterOperand(0).index());
+  while (IsJSBoundFunction(target) || IsJSProxy(target)) {
+    target = IsJSBoundFunction(target) ? Cast<JSBoundFunction>(target)->bound_target_function()
+                                     : Cast<JSProxy>(target)->target();
+  }
+  if (!IsJSFunction(target)) return;
+  auto shared = Cast<JSFunction>(target)->shared();
+  if (!shared->IsApiFunction() && !shared->HasBuiltinId()) return;
+  pending[frame->fp()] = {0, iterator.current_offset(), iterator.current_offset() + iterator.current_bytecode_size(), {}, CausalCurrent(isolate)};
+}
+
+void NativeCallsiteComplete(Isolate* isolate, UnoptimizedJSFrame* frame,
+                            int offset, Tagged<Object> result) {
+  if (!v8_flags.trace_native_detail) return;
+  auto& pending = native_sites[isolate];
+  auto found = pending.find(frame->fp());
+  if (found == pending.end() || found->second.instruction != offset) return;
+  auto call = found->second;
+  if (call.id) DetailEvent(isolate, "native", [&](std::ostream& out) {
+    out << ",\"phase\":\"return\",\"callId\":\"" << call.id
+        << "\",\"completionSource\":\"ignition-call-exit\",\"result\":";
+    DetailValue(out, isolate, result);
+  },call.causal);
+  pending.erase(found);
+}
+
+void NativeJsEntry(Isolate* isolate, Address raw_target, intptr_t argc,
+                   Address* argv, Address frame, Address new_target,
+                   intptr_t construct) {
+  if (construct == 2) {
+    if (!v8_flags.trace_native_detail) return;
+    auto& pending = native_sites[isolate];
+    auto found = pending.find(frame);
+    if (found == pending.end()) return;
+    auto call = found->second;
+    if (call.id) DetailEvent(isolate, "native", [&](std::ostream& out) {
+      out << ",\"phase\":\"return\",\"callId\":\"" << call.id
+          << "\",\"completionSource\":\"interpreter-return-trampoline\",\"result\":";
+      DetailValue(out, isolate, Tagged<Object>(raw_target));
+    },call.causal);
+    pending.erase(found);
+    return;
+  }
+  if (!v8_flags.trace_native_detail || argc < 1) return;
+  Tagged<Object> target(raw_target);
+  if (!IsJSFunction(target)) return;
+  auto shared = Cast<JSFunction>(target)->shared();
+  if (!shared->IsApiFunction() && !shared->HasBuiltinId()) return;
+  auto& pending = native_sites[isolate];
+  auto current = pending.find(frame);
+  if (current == pending.end() || current->second.id) return;
+  if (DetailFilter().active && !NativeSelected(isolate, shared->IsApiFunction() ? NativeKind::kApiOperation : NativeKind::kJsBuiltin,
+                       FunctionSource(isolate, Cast<JSFunction>(target)).function)) return;
+  DetailEvent(isolate, "native", [&](std::ostream& out) {
+    uint64_t id = ++detail_calls;
+    current->second.id = id;
+    out << ",\"phase\":\"entry\",\"callId\":\"" << id
+        << "\",\"boundary\":\"x64-js-native-entry\",\"argumentsComplete\":true,\"name\":";
+    JsonString(out, shared->Name());
+    if (DetailFilter().active) FilterSourceJson(out, CurrentSource(isolate));
+    out << ",\"target\":"; DetailValue(out, isolate, target);
+    out << ",\"receiver\":"; DetailValue(out, isolate, Tagged<Object>(argv[0]));
+    if (construct) { out << ",\"newTarget\":"; DetailValue(out, isolate, Tagged<Object>(new_target)); }
+    out << ",\"arguments\":[";
+    for (intptr_t i = 1; i < argc; ++i) { if (i > 1) out << ','; DetailValue(out, isolate, Tagged<Object>(argv[i])); }
+    out << ']';
+  });
+}
+
+uint64_t NativeCallbackEnter(Isolate* isolate, Address address,
+                            v8::ExceptionContext type, const void* raw) {
+  if (!v8_flags.trace_native_detail || !raw) return 0;
+  if (DetailFilter().active) {
+  std::u16string filter_name;
+  if (type == v8::ExceptionContext::kOperation || type == v8::ExceptionContext::kConstructor) {
+    auto target = FunctionCallbackArguments::GetTarget(*static_cast<const v8::FunctionCallbackInfo<v8::Value>*>(raw));
+    if (!OutsideObjectCage(isolate, target) && IsJSFunction(target)) filter_name = FilterString(Cast<JSFunction>(target)->shared()->Name());
+  } else if (type != v8::ExceptionContext::kNamedEnumerator) {
+    const auto& info = *static_cast<const v8::PropertyCallbackInfo<v8::Value>*>(raw);
+    if (PropertyCallbackArguments::IsNamed(info)) {
+      auto property = *PropertyCallbackArguments::GetPropertyName(info);
+      if (IsString(property)) filter_name = FilterString(Cast<String>(property));
+    }
+  }
+  if (!NativeSelected(isolate, ApiKind(type), filter_name)) return 0;
+  }
+  uint64_t id = 0;
+  DetailEvent(isolate, "native", [&](std::ostream& out) {
+    id = ++detail_calls;
+    out << ",\"phase\":\"entry\",\"callId\":\"" << id
+        << "\",\"boundary\":\"v8-api-callback\",\"callbackAddress\":";
+    Pointer(out, address);
+    out << ",\"exceptionContext\":" << static_cast<int>(type);
+    if (DetailFilter().active) FilterSourceJson(out, CurrentSource(isolate));
+    if (type == v8::ExceptionContext::kOperation || type == v8::ExceptionContext::kConstructor) {
+      const auto& info = *static_cast<const v8::FunctionCallbackInfo<v8::Value>*>(raw);
+      out << ",\"target\":"; DetailValue(out, isolate, FunctionCallbackArguments::GetTarget(info));
+      out << ",\"receiver\":"; DetailValue(out, isolate, *Utils::OpenDirectHandle(*info.This()));
+      out << ",\"newTarget\":"; DetailValue(out, isolate, *Utils::OpenDirectHandle(*info.NewTarget()));
+      out << ",\"arguments\":[";
+      for (int i = 0; i < info.Length(); ++i) { if (i) out << ','; DetailValue(out, isolate, *Utils::OpenDirectHandle(*info[i])); }
+      out << ']';
+    } else {
+      const auto& info = *static_cast<const v8::PropertyCallbackInfo<v8::Value>*>(raw);
+      out << ",\"receiver\":"; DetailValue(out, isolate, *Utils::OpenDirectHandle(*info.Holder()));
+      if (type != v8::ExceptionContext::kNamedEnumerator) {
+        out << ",\"property\":";
+        if (PropertyCallbackArguments::IsNamed(info)) DetailValue(out, isolate, *PropertyCallbackArguments::GetPropertyName(info));
+        else out << "{\"type\":\"number\",\"value\":" << PropertyCallbackArguments::GetPropertyIndex(info) << '}';
+      }
+    }
+  });
+  return id;
+}
+
+void NativeCallbackExit(Isolate* isolate, uint64_t id,
+                       v8::ExceptionContext type, const void* raw) {
+  if (!id) return;
+  DetailEvent(isolate, "native", [&](std::ostream& out) {
+    out << ",\"phase\":\"" << (isolate->has_exception() ? "throw" : "return")
+        << "\",\"callId\":\"" << id << "\",";
+    if (isolate->has_exception()) { out << "\"exception\":"; DetailValue(out, isolate, isolate->exception()); }
+    else {
+      out << "\"result\":";
+      if (type == v8::ExceptionContext::kOperation || type == v8::ExceptionContext::kConstructor)
+        DetailValue(out, isolate, *Utils::OpenDirectHandle(*static_cast<const v8::FunctionCallbackInfo<v8::Value>*>(raw)->GetReturnValue().Get()));
+      else DetailValue(out, isolate, *Utils::OpenDirectHandle(*static_cast<const v8::PropertyCallbackInfo<v8::Value>*>(raw)->GetReturnValue().Get()));
+    }
+  });
+}
+
+void NativeExtra(Isolate* isolate, uint64_t id, const char* name, Tagged<Object> value) {
+  if (!id) return;
+  DetailEvent(isolate, "native", [&](std::ostream& out) {
+    out << ",\"phase\":\"argument\",\"callId\":\"" << id << "\",\"name\":";
+    Ascii(out, name); out << ",\"value\":"; DetailValue(out, isolate, value);
+  });
+}
+
+void NativeDescriptor(Isolate* isolate, uint64_t id, const v8::PropertyDescriptor& desc) {
+  if (!id) return;
+  if (desc.has_value()) NativeExtra(isolate, id, "descriptor.value", *Utils::OpenDirectHandle(*desc.value()));
+  if (desc.has_get()) NativeExtra(isolate, id, "descriptor.get", *Utils::OpenDirectHandle(*desc.get()));
+  if (desc.has_set()) NativeExtra(isolate, id, "descriptor.set", *Utils::OpenDirectHandle(*desc.set()));
+  if (desc.has_writable()) NativeExtra(isolate, id, "descriptor.writable", isolate->heap()->ToBoolean(desc.writable()));
+  if (desc.has_enumerable()) NativeExtra(isolate, id, "descriptor.enumerable", isolate->heap()->ToBoolean(desc.enumerable()));
+  if (desc.has_configurable()) NativeExtra(isolate, id, "descriptor.configurable", isolate->heap()->ToBoolean(desc.configurable()));
+}
+
+uint64_t NativeArgumentsEnter(Isolate* isolate, const char* name, int count,
+                              const std::function<Tagged<Object>(int)>& argument,
+                              bool receiver) {
+  if (!v8_flags.trace_native_detail || std::strncmp(name, "Runtime_Trace", 13) == 0) return 0;
+  if (DetailFilter().active) {
+  std::u16string filter_name;
+  for (const unsigned char* ch = reinterpret_cast<const unsigned char*>(name); *ch; ++ch) filter_name.push_back(*ch);
+  if (!NativeSelected(isolate, receiver ? NativeKind::kCppBuiltin : NativeKind::kRuntime, filter_name)) return 0;
+  }
+  uint64_t id = 0;
+  DetailEvent(isolate, "native", [&](std::ostream& out) {
+    id = ++detail_calls;
+    out << ",\"phase\":\"entry\",\"callId\":\"" << id << "\",\"boundary\":\""
+        << (receiver ? "cpp-builtin" : "v8-runtime") << "\",\"name\":";
+    Ascii(out, name);
+    if (DetailFilter().active) FilterSourceJson(out, CurrentSource(isolate));
+    if (receiver && count) { out << ",\"receiver\":"; DetailValue(out, isolate, argument(0)); }
+    out << ",\"arguments\":[";
+    for (int i = receiver ? 1 : 0; i < count; ++i) { if (i > (receiver ? 1 : 0)) out << ','; DetailValue(out, isolate, argument(i)); }
+    out << ']';
+  });
+  return id;
+}
+
+void NativeArgumentsExit(Isolate* isolate, uint64_t id, Tagged<Object> result,
+                         Tagged<Object> second, bool pair) {
+  if (!id) return;
+  DetailEvent(isolate, "native", [&](std::ostream& out) {
+    out << ",\"phase\":\"" << (isolate->has_exception() ? "throw" : "return")
+        << "\",\"callId\":\"" << id << "\",\"result\":";
+    DetailValue(out, isolate, result);
+    if (pair) { out << ",\"secondResult\":"; DetailValue(out, isolate, second); }
+    if (isolate->has_exception()) { out << ",\"exception\":"; DetailValue(out, isolate, isolate->exception()); }
+  });
+}
