+    output << ']'; if (v8_flags.trace_vmp) { output << ",\"vmpConfigToken\":"; Text(output, static_cast<const char*>(v8_flags.trace_vmp_config)); output << ",\"vmpConfigValid\":" << (VmpConfigValid() ? "true" : "false") << ",\"vmpBudget\":{\"depth\":" << static_cast<uint32_t>(v8_flags.trace_vmp_depth) << ",\"nodes\":" << static_cast<uint32_t>(v8_flags.trace_vmp_nodes) << ",\"properties\":" << static_cast<uint32_t>(v8_flags.trace_vmp_properties) << ",\"typedArrayBytes\":" << static_cast<uint32_t>(v8_flags.trace_vmp_typed_bytes) << ",\"maxActive\":" << static_cast<uint32_t>(v8_flags.trace_vmp_max_active) << '}'; } output << '}'; context.AddDebugAnnotation("record", output.str());
+  });
+#endif
+}
+inline void Stop() {
+  for (const auto& producer : Session().Stop()) {
+#if defined(V8_USE_PERFETTO)
+    TRACE_EVENT_INSTANT(TRACE_DISABLED_BY_DEFAULT("v8.aux"), "V8TraceAuxStats", [&](perfetto::EventContext context) {
+      std::ostringstream output; output << "{\"protocol\":\"v8trace/state-stats/1\",\"producerFamily\":\"v8-aux\",\"epoch\":\"" << producer.epoch << "\",\"producerThreadId\":\"" << producer.thread_id << "\",\"producerId\":\"" << producer.producer_id << "\",\"attempted\":\"" << producer.attempted << "\",\"emittedEvents\":\"" << producer.emitted << "\",\"final\":" << (producer.final ? "true" : "false") << '}'; context.AddDebugAnnotation("record", output.str());
+    });
+#endif
+  }
+  Boundary("stop");
+}
+inline void Identity(std::ostream& output, Isolate* isolate) {
+  if (!isolate) return; auto identity = v8::V8TraceIdentity(reinterpret_cast<v8::Isolate*>(isolate));
+  output << ",\"identity\":{\"protocol\":\"v8trace/identity/1\",\"isolateId\":\"" << std::hex << identity.isolate_id << std::dec << "\",\"realmId\":\"" << identity.realm_id << "\",\"jsCallId\":\"" << identity.js_call_id << "\",\"nativeCallId\":\"" << identity.native_call_id << "\",\"callProducerId\":\"" << identity.producer_id << "\",\"callEpoch\":\"" << identity.epoch << "\"}";
+}
+inline void Chunks(uint64_t id, uint64_t offset, base::Vector<const uint8_t> bytes) {
+  for (size_t index = 0; index < bytes.size(); index += 32768) { auto count = std::min<size_t>(32768, bytes.size() - index); auto part = bytes.SubVector(index, index + count);
+    if(!AuxEnabled("wasm-module"))return;
+    Emit("wasm-module", [&](std::ostream& output) { output << ",\"kind\":\"value-chunk\",\"operationId\":\"" << id << "\",\"contentId\":\"" << id << "/wire\",\"offset\":\"" << offset + index << "\",\"base64\":\"" << Base64(part) << '"'; });
+  }
+}
+inline void Wire(std::ostream& output, uint64_t id, uint64_t bytes) { output << ",\"wire\":{\"type\":\"byte-reference\",\"contentId\":\"" << id << "/wire\",\"bytes\":\"" << bytes << "\",\"representation\":\"wasm-wire-bytes\"}"; }
+}
+uint64_t AuxId() { static std::atomic_uint64_t value{0}; return value.fetch_add(1, std::memory_order_relaxed) + 1; }
+bool AuxEnabled(const char* channel) {
+  bool enabled = false;
+  if (std::string_view(channel) == "vmp") { if (!v8_flags.trace_vmp) return false; TRACE_EVENT_CATEGORY_GROUP_ENABLED(TRACE_DISABLED_BY_DEFAULT("v8.vmp"), &enabled); }
+  else { if (!v8_flags.trace_wasm_modules) return false; TRACE_EVENT_CATEGORY_GROUP_ENABLED(TRACE_DISABLED_BY_DEFAULT("v8.wasm-module"), &enabled); }
+  return enabled;
+}
+void AuxSessionStart(uint32_t instance) { if (!AuxEnabled("vmp") && !AuxEnabled("wasm-module")) return; auto& owner = aux::TraceOwner(); std::lock_guard lock(owner.mutex); if (owner.instance != -1) return; owner.instance = instance; aux::Session().Start(); aux::Boundary("start"); }
+void AuxSessionStop(uint32_t instance) { auto& owner = aux::TraceOwner(); std::lock_guard lock(owner.mutex); if (owner.instance == instance) { aux::Stop(); owner.instance = -1; } }
+void AuxSessionShutdown() { auto& owner = aux::TraceOwner(); std::lock_guard lock(owner.mutex); if (owner.instance != -1) { aux::Stop(); owner.instance = -1; } }
+uint64_t WasmInput(Isolate* isolate, base::Vector<const uint8_t> bytes, const char* kind, uint64_t module, std::string_view url, int compilation) {
+  if (!AuxEnabled("wasm-module")) return 0; auto id = AuxId(); aux::Chunks(id, 0, bytes);
+  aux::Emit("wasm-module", [&](std::ostream& output) { output << ",\"kind\":\"module-bytes\",\"operationId\":\"" << id << "\",\"observation\":"; aux::Text(output, kind); output << ",\"moduleId\":\"" << module << "\",\"compilationId\":\"" << compilation << "\",\"byteCoverage\":\"complete-input\",\"urlEncoding\":\"original-utf8-bytes\",\"urlBase64\":\"" << aux::Base64(base::VectorOf(reinterpret_cast<const uint8_t*>(url.data()), url.size())) << '"'; aux::Wire(output, id, bytes.size()); aux::Identity(output, isolate); }); return id;
+}
+void WasmResult(Isolate* isolate, uint64_t attempt, bool success, uint64_t module, const char* message) { if (!attempt) return; aux::Emit("wasm-module", [&](std::ostream& output) { output << ",\"kind\":\"compile-result\",\"operationId\":\"" << attempt << "\",\"success\":" << (success ? "true" : "false") << ",\"moduleId\":\"" << module << "\",\"messageByteEncoding\":\"original-bytes\",\"messageBase64\":\"" << aux::Base64(base::VectorOf(reinterpret_cast<const uint8_t*>(message), std::strlen(message))) << '"'; aux::Identity(output, isolate); }); }
+void WasmPrefix(uint64_t id, uint64_t offset, base::Vector<const uint8_t> bytes) { if (AuxEnabled("wasm-module")) aux::Chunks(id, offset, bytes); }
+void WasmPrefixEnd(uint64_t id, uint64_t bytes, std::string_view url) { aux::Emit("wasm-module", [&](std::ostream& output) { output << ",\"kind\":\"module-bytes\",\"operationId\":\"" << id << "\",\"observation\":\"stream-stopped-prefix\",\"byteCoverage\":\"prefix-only-stream-stopped\",\"urlBase64\":\"" << aux::Base64(base::VectorOf(reinterpret_cast<const uint8_t*>(url.data()), url.size())) << '"'; aux::Wire(output, id, bytes); }); }
+uint64_t WasmArgument(Isolate* isolate,const uint8_t* data,size_t bytes,const char* kind){
+  if(!AuxEnabled("wasm-module"))return 0;auto id=AuxId();std::array<uint8_t,32768> block;
+  for(size_t offset=0;offset<bytes;offset+=block.size()){if(!AuxEnabled("wasm-module"))return 0;auto count=std::min(block.size(),bytes-offset);for(size_t i=0;i<count;++i)block[i]=std::atomic_ref<uint8_t>(const_cast<uint8_t&>(data[offset+i])).load(std::memory_order_relaxed);aux::Chunks(id,offset,base::VectorOf(block.data(),count));}
+  aux::Emit("wasm-module",[&](std::ostream& out){out<<",\"kind\":\"module-bytes\",\"operationId\":\""<<id<<"\",\"observation\":";aux::Text(out,kind);out<<",\"byteCoverage\":\"complete-rejected-input-observation\",\"snapshotScope\":\"relaxed-byte-observation-not-API-consumed-copy\"";aux::Wire(out,id,bytes);aux::Identity(out,isolate);});return id;
+}
+void WasmRejected(Isolate* isolate,const char* reason){aux::Emit("wasm-module",[&](std::ostream& out){out<<",\"kind\":\"module-input-rejected\",\"operationId\":\""<<AuxId()<<"\",\"hasByteSource\":false,\"reason\":";aux::Text(out,reason);aux::Identity(out,isolate);});}
+}
