+V8TraceIdentitySnapshot V8TraceIdentity(v8::Isolate* api) {
+  V8TraceIdentitySnapshot result;
+  if (!api) return result;
+  auto* isolate = reinterpret_cast<internal::Isolate*>(api);
+  internal::HandleScope handles(isolate);
+  internal::DisallowGarbageCollection no_gc;
+  result.isolate_id = isolate->debug()->IsolateId();
+  if (auto* realm = internal::v8trace::env_probe::CurrentRealm(isolate)) result.realm_id = realm->id;
+  if (internal::v8trace::JsTracingEnabled()) {
+    result.producer_id = internal::v8trace::CallStats().producer_id;
+    result.epoch = internal::v8trace::CallStats().epoch;
+    result.js_event_sequence = internal::v8trace::detail_sequences[0];
+    internal::JavaScriptStackFrameIterator frame(isolate);
+    if (!frame.done()) {
+      auto& calls = internal::v8trace::js_calls[isolate];
+      auto found = calls.find(frame.frame()->fp());
+      if (found != calls.end()) {
+        result.js_call_id = found->second.id;
+        result.producer_id = internal::v8trace::CallStats().producer_id;
+        result.epoch = internal::v8trace::CallStats().epoch;
+      }
+    }
+  }
